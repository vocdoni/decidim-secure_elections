# decidim-secure_elections configuration.
#
# Copy to .env and fill in. In production prefer Rails encrypted credentials for
# the API key (`vocdoni.api_key`); this file exists for container deployments
# where credentials are not mounted.

# Base URL of the Vocdoni SaaS API. REQUIRED — there is deliberately no default,
# so that a production deployment cannot silently run against a test chain.
# Left empty on purpose: copying this file must not hand you a staging chain.
#   production:  https://saas-api.vocdoni.net
#   staging:     https://saas-api-stg.vocdoni.net
#   development: https://saas-api-dev.vocdoni.net
VOCDONI_API_URL=

# Integrator API key (vsk_…). REQUIRED. Server-side only — never exposed to the browser.
VOCDONI_API_KEY=

# Address of the Vocdoni organization that owns the processes this instance
# creates. REQUIRED. Obtain once with `rails decidim_secure_elections:create_organization`.
VOCDONI_ORG_ADDRESS=

# Public explorer a voter follows to check their receipt. OPTIONAL: it is
# derived from VOCDONI_API_URL, so the two can never disagree. Set it only for
# a self-hosted network.
#   production:  https://explorer.vote
#   staging:     https://stg.explorer.vote
#   development: https://dev.explorer.vote
# VOCDONI_EXPLORER_URL=

# HTTP tuning (seconds).
VOCDONI_OPEN_TIMEOUT=5
VOCDONI_TIMEOUT=30
VOCDONI_JOB_TIMEOUT=120
