<%#
  The Census tab — this engine's version of it.

  Upstream ships the same template path and this one wins (the view path is
  prepended in `Decidim::Elections::Vocdoni::CensusPage`). Everything upstream
  does still happens: the page is one `PATCH` to its own controller, the census
  type travels as `manifest` and the registered-participants inputs keep the
  names `Decidim::Elections::Admin::Censuses::InternalUsersForm` expects, so
  `ProcessCensus` is untouched.

  What changed is the shape: the type is chosen as a card, with what it means
  written on it, and its set-up is on the same page instead of behind a reload.
  Both set-up blocks are rendered and the radio only decides which one is
  shown, so nothing an admin typed is lost by looking at the other option.

  `internal_users_form`, `verification_rows`, `eligible_count` and
  `census_voters_count` come from `CensusPage`.
%>
<% add_decidim_page_title(t("decidim.elections.admin.census.edit.title")) %>
<%# Upstream's pack still carries the admin-wide behaviour of this section. %>
<% append_javascript_pack_tag "decidim_elections_admin" %>
<% append_javascript_pack_tag "decidim_elections_vocdoni_admin" %>
<% append_stylesheet_pack_tag "decidim_elections_vocdoni_admin", media: "all" %>
<% scope = "decidim.elections.vocdoni.admin.census_setup" %>
<%# The in-memory manifest: what the admin last chose, saved or not. %>
<% chosen = election.census&.name.to_s %>

<div class="item_show__header border-none">
  <h1 class="item_show__header-title"><%= t("decidim.elections.admin.census.edit.title") %></h1>
</div>

<%= render "decidim/elections/admin/elections/tabs_menu" %>

<%# Without JavaScript nothing can unhide the set-up block of a type the
    admin has just picked, so both are shown and the radio decides which one
    the server reads. The rule is inert otherwise. %>
<noscript>
  <%# Outranks the `[hidden]` rule the page's own stylesheet sets. %>
  <style>.vocdoni-census [data-census-block][hidden] { display: block !important; }</style>
</noscript>

<div class="item__edit-form vocdoni-census vocdoni-cards">
  <%# No `manifest` in the URL: a query parameter would outrank the radio in
      the body, and the radio is the answer now. The path comes from the
      component's admin proxy rather than the bare route helper, which only
      resolves inside upstream's engine. %>
  <%= decidim_form_for(internal_users_form,
                       url: Decidim::EngineRouter.admin_proxy(election.component).census_election_path(election),
                       method: :patch,
                       html: { id: "census-election-form", class: "form-defaults form" }) do |f| %>
    <%= render "decidim/elections/vocdoni/admin/census_setup/choice", chosen: %>
    <%= render "decidim/elections/vocdoni/admin/census_setup/registered", f:, chosen: %>
    <%= render "decidim/elections/vocdoni/admin/census_setup/file", chosen: %>
    <%= render "decidim/elections/vocdoni/admin/census_setup/next_step" %>

    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%# The button stays reachable and explains itself rather than
            disappearing until a card is picked (`disabled` cannot be focused,
            so it cannot be asked why). %>
        <span class="vocdoni-census__save-hint" id="js-census-save-hint" <%= "hidden" if chosen.present? %>>
          <%= t("save_hint", scope:) %>
        </span>
        <%# `census_setup.js` puts a confirmation on this button when the
            chosen card would delete the uploaded list. The card says so too,
            in words, for anyone without JavaScript. %>
        <%= f.submit t("save", scope: "decidim.elections.admin.elections.form"),
                     id: "js-census-submit",
                     class: "button button__sm button__secondary",
                     data: {
                       voters: census_voters_count,
                       "confirm-title": t("confirm_switch.title", scope:),
                       "confirm-body": t("confirm_switch.body", scope:, count: census_voters_count)
                     },
                     aria: { disabled: chosen.blank?, describedby: "js-census-save-hint" } %>
      </div>
    </div>
  <% end %>
</div>
