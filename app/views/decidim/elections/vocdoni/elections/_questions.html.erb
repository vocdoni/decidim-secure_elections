<ol class="vocdoni-questions">
  <% questions.each_with_index do |question, index| %>
    <li class="vocdoni-questions__item">
      <h3 class="h6">
        <span class="sr-only"><%= t("decidim.elections.vocdoni.elections.show.question_number", number: index + 1) %></span>
        <%= translated_attribute(question.body) %>
      </h3>

      <% if translated_attribute(question.description).present? %>
        <div class="editor-content text-sm">
          <%= decidim_sanitize_editor_admin(translated_attribute(question.description)) %>
        </div>
      <% end %>

      <p class="text-sm text-gray-2">
        <%= t("decidim.elections.vocdoni.elections.question_types.#{question.question_type}", default: question.question_type) %>
        <% if question.multichoice? %>
          &middot; <%= t("decidim.elections.vocdoni.elections.show.max_choices", count: question.effective_max_choices) %>
        <% end %>
        <% if question.secret_until_the_end %>
          &middot;
          <%= icon "lock-line", role: "img", "aria-hidden": true, class: "inline fill-current" %>
          <%= t("decidim.elections.vocdoni.elections.show.secret_until_the_end") %>
        <% end %>
      </p>

      <ul class="vocdoni-questions__answers">
        <% question.answers.each do |answer| %>
          <li><%= translated_attribute(answer.body) %></li>
        <% end %>
      </ul>
    </li>
  <% end %>
</ol>
