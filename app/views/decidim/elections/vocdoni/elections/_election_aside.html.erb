<%
  # The voting page is a static page shipped inside this gem, not a Decidim
  # route: `voting_page_url` builds `/vocdoni/vote.html?v=…`. It is nil until
  # the election is on chain — there is then no process to open, and the aside
  # says so rather than offering a link that could only fail.
  #
  # This one keeps its exit: a voter who got here from the election page has an
  # election page to go back to. The link the admin panel hands out for an email
  # does not, and is shorter for it.
  vote_link = voting_page_url
%>

<section class="layout-aside__section">
  <div class="layout-aside__ctas-buttons" data-controller="sticky-buttons">
    <% if vote_link.blank? %>
      <p class="vocdoni-election__notice">
        <%= t("decidim.elections.vocdoni.elections.show.voting_closed.#{election_state}",
              default: t("decidim.elections.vocdoni.elections.show.voting_closed.draft")) %>
      </p>
    <% elsif voting_open? %>
      <%# No Decidim verification gate: who may vote is the Vocdoni census's
          answer, decided in the voter's browser (ARCHITECTURE §3). Somebody who is
          not on the census reaches the voting page and is told so, which is the
          only place that can honestly tell them. %>
      <%= link_to t("decidim.elections.vocdoni.elections.show.vote_button"),
                  vote_link,
                  class: "button button__secondary button__lg" %>
    <% else %>
      <p class="vocdoni-election__notice">
        <%= t("decidim.elections.vocdoni.elections.show.voting_closed.#{election_state}",
              default: t("decidim.elections.vocdoni.elections.show.voting_closed.ended")) %>
      </p>
    <% end %>

    <%# A receipt outlives the vote: the nullifier is fetched back from the CSP
        after the voter identifies themselves again, so this stays available
        once voting has closed. %>
    <% if vote_link.present? %>
      <%= link_to t("decidim.elections.vocdoni.elections.show.receipt_button"),
                  vote_link,
                  class: "button button__lg button__transparent-secondary mt-4" %>
    <% end %>
  </div>
</section>

<section class="layout-aside__section">
  <h2 class="h6"><%= t("decidim.elections.vocdoni.elections.show.how_it_works_title") %></h2>
  <div class="vocdoni-election__notice text-sm space-y-2">
    <p>
      <%= icon "shield-check-line", role: "img", "aria-hidden": true, class: "inline fill-current" %>
      <%= t("decidim.elections.vocdoni.elections.show.how_it_works_body") %>
    </p>

    <% if election.census_size.to_i.positive? %>
      <p><%= t("decidim.elections.vocdoni.elections.show.census_size", count: election.census_size) %></p>
    <% end %>

    <% if election.auth_fields.any? %>
      <p>
        <%= t("decidim.elections.vocdoni.elections.show.census_fields",
              fields: election.auth_fields.map { |field| t("decidim.elections.vocdoni.census.fields.#{field}", default: field.to_s.humanize) }.to_sentence) %>
      </p>
    <% end %>
  </div>
</section>
