<%#
  Voter-side landing for a Vocdoni-backed election. Rendered by the
  votes/new override when `election.vocdoni_process` is present on chain.
  Points the voter at the standalone booth SPA at `/vocdoni/vote.html`.

  The SPA reads the API URL, process id and locale from its query string,
  fetches the *public* process from the SaaS and drives the whole voting flow
  client-side (auth against the CSP, ZK ballot signing, on-chain submission).
  Nothing else is rendered here.

  The sidecar `Vocdoni::Process` holds the on-chain process id — read straight
  off `election.vocdoni_process` (has_one installed by the engine's
  engine).
%>
<%
  process = election.vocdoni_process
  process_id = process&.vocdoni_process_id
  api_url = Decidim::Elections::Vocdoni.api_url
  # The upstream engine's URL helpers live on a per-component router; the
  # bare `election_path(election)` helper is not in scope inside a votes
  # partial. Build the exit path by hand so a browser back-nav from the
  # SPA drops the voter back on the election page rather than the site
  # root.
  exit_path = Decidim::EngineRouter.main_proxy(election.component).election_path(election)
%>

<div class="row column mt-8">
  <% if process_id.present? %>
    <p class="mb-4">
      <%= t("decidim.elections.vocdoni.booth.launcher.help_html",
             default: "Your vote is cast using Vocdoni’s secure technology, guaranteeing anonymity and verifiability.") %>
    </p>
    <%
      booth_url = "/vocdoni/vote.html?api=#{CGI.escape(api_url)}&process=#{CGI.escape(process_id)}&locale=#{I18n.locale}&exit=#{CGI.escape(exit_path)}"
    %>
    <%= link_to booth_url,
                target: "_top",
                class: "button button__lg button__secondary",
                data: { turbo: false } do %>
      <%= t("decidim.elections.vocdoni.booth.launcher.enter",
             default: "Open the voting booth") %>
    <% end %>
  <% else %>
    <p class="mb-4">
      <%= t("decidim.elections.vocdoni.booth.launcher.not_ready",
             default: "This election is not yet ready to accept votes on the blockchain. Please try again in a few moments.") %>
    </p>
  <% end %>
</div>
