<%# Receipt note for the `vocdoni` voting backend. %>
<p class="mt-6 text-center"><%= t("decidim.elections.vocdoni.votes.page.receipt.body") %></p>
<p class="mt-2 text-center"><%= t("decidim.elections.vocdoni.booth.receipt.final") %></p>
<% if election.vocdoni_process&.attested? %>
  <p class="mt-2 text-center">
    <%= t("decidim.elections.vocdoni.booth.receipt.check_attestation") %>
    <%= link_to t("decidim.elections.vocdoni.booth.receipt.check_attestation_link"),
                Decidim::EngineRouter.main_proxy(election.component).election_vocdoni_attestation_path(election) %>
  </p>
<% end %>
