<%#
  Pre-ballot panel for the `vocdoni` voting backend: the one-time code the CSP
  sent. Shown by the adapter. Mirrors the markup of decidim-elections' census
  check (`votes/new` + `censuses/_submit_button`), which the voter has just
  passed, so both identity steps look the same.
%>
<% otp = t("decidim.elections.vocdoni.votes.page.otp") %>
<form data-vocdoni-otp-form class="form form-defaults" novalidate>
  <div class="form__wrapper">
    <div class="flex justify-center">
      <h1 class="title-decorator my-12" tabindex="-1"><%= otp[:title] %></h1>
    </div>
    <p>
      <%= otp[:body_email] %>
      <% if booth_config.dig(:contact, :masked).present? %>
        (<strong><%= booth_config.dig(:contact, :masked) %></strong>)
      <% end %>
    </p>
    <label for="vocdoni-otp-code">
      <%= otp[:label] %>
      <input id="vocdoni-otp-code" type="text" inputmode="numeric" autocomplete="one-time-code" required aria-describedby="vocdoni-otp-hint vocdoni-otp-error" data-vocdoni-otp-code>
      <span class="help-text" id="vocdoni-otp-hint"><%= otp[:hint] %></span>
      <span class="form-error" id="vocdoni-otp-error" role="alert" data-vocdoni-otp-feedback></span>
    </label>
    <div class="form__wrapper-block flex-col-reverse md:flex-row justify-end">
      <button type="button" class="button button__sm md:button__lg button__transparent-secondary" data-vocdoni-otp-resend disabled><%= otp[:resend] %></button>
      <button type="submit" class="button button__sm md:button__lg button__secondary"><%= otp[:submit] %></button>
    </div>
  </div>
</form>
