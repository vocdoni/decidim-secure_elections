<%#
  Rendered instead of upstream's voting wizard for a Vocdoni election when the
  `vocdoni` voting backend is not active (see `Vocdoni::RedirectsVoterToBooth`).
%>
<div class="wrapper">
  <div class="row column">
    <h1 class="title-decorator my-8"><%= decidim_sanitize_translated(election.title) %></h1>
    <p class="mb-4" data-vocdoni-booth-unavailable><%= t("decidim.elections.vocdoni.booth.unavailable") %></p>
  </div>
</div>
