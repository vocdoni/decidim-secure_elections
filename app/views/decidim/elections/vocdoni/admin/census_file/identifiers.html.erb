<%#
  Changing the details voters type, on a list that is already imported.

  Reached from "Change" on the Census tab. The same question the wizard asks
  in its last step, on its own and without touching the file: the columns are
  settled, so only the details the list actually has are offered.
%>
<% scope = "decidim.elections.vocdoni.admin.census_file.identifiers" %>
<% add_decidim_page_title(t("page_title", scope:)) %>
<% append_javascript_pack_tag "decidim_elections_vocdoni_admin" %>
<% append_stylesheet_pack_tag "decidim_elections_vocdoni_admin", media: "all" %>

<div class="item_show__header border-none">
  <h1 class="item_show__header-title"><%= t("page_title", scope:) %></h1>
</div>

<%= render "decidim/elections/admin/elections/tabs_menu" %>

<div class="item__edit-form vocdoni-census-file">
  <%= decidim_form_for(@form,
                       url: wizard_path(:identifiers),
                       method: :patch,
                       html: { id: "js-census-identifiers-form", class: "form-defaults form" }) do |f| %>
    <%# No card title: the fieldset's own legend asks the question, and the
        page heading already names the page. %>
    <div class="card vocdoni-census-file__card">
      <div class="card-section">
        <div class="row column">
          <%= render "decidim/elections/vocdoni/admin/census_file/identifiers",
                     form: @form,
                     name: "census_identifiers" %>
        </div>
      </div>
    </div>

    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%= link_to t("cancel", scope:), census_path, class: "button button__sm button__transparent-secondary" %>
        <%= f.submit t("submit", scope:), class: "button button__sm button__secondary" %>
      </div>
    </div>
  <% end %>
</div>
