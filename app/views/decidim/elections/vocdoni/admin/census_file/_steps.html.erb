<%#
  Locals:
    current - :upload or :match, which step is the current one.

  A plain two-item list rather than a fancy widget: it works without CSS or
  JavaScript, and `aria-current="step"` is what a screen reader needs to
  announce "current" — the visual highlight in census_file.scss is
  decoration on top of that, not a replacement for it.
%>
<% scope = "decidim.elections.vocdoni.admin.census_file.steps" %>
<nav class="vocdoni-census-file__steps" aria-label="<%= t("aria_label", scope:) %>">
  <ol>
    <%= tag.li class: "vocdoni-census-file__step#{" is-current" if current == :upload}",
               aria: { current: ("step" if current == :upload) } do %>
      <span class="vocdoni-census-file__step-number" aria-hidden="true">1</span>
      <span class="vocdoni-census-file__step-name"><%= t("upload", scope:) %></span>
    <% end %>
    <%= tag.li class: "vocdoni-census-file__step#{" is-current" if current == :match}",
               aria: { current: ("step" if current == :match) } do %>
      <span class="vocdoni-census-file__step-number" aria-hidden="true">2</span>
      <span class="vocdoni-census-file__step-name"><%= t("match", scope:) %></span>
    <% end %>
  </ol>
</nav>
