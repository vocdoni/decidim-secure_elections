<%#
  Step 2 of the "Participants from a file" wizard: match columns.

  @form is a CensusFileMappingForm, already carrying the uploaded file (as a
  signed blob id) and a suggested mapping the controller pre-filled. The
  only field actually bound to the form builder is the hidden `blob`; every
  select is built by hand because `columns` is a Hash keyed by column
  position, not a real per-column attribute.
%>
<% scope = "decidim.elections.vocdoni.admin.census_file.edit" %>
<% add_decidim_page_title(t("title", scope:)) %>
<% append_javascript_pack_tag "decidim_elections_vocdoni_admin" %>
<% append_stylesheet_pack_tag "decidim_elections_vocdoni_admin", media: "all" %>

<% target_options = [[t("no_value", scope:), ""]] +
                    Decidim::Elections::Vocdoni::CensusCsv::Fields::TARGETS.map { |field| [Decidim::Elections::Vocdoni::CensusCsv::Fields.label(field), field] } %>

<div class="item_show__header border-none">
  <h1 class="item_show__header-title"><%= t("title", scope:) %></h1>
</div>

<%= render "decidim/elections/admin/elections/tabs_menu" %>

<div class="vocdoni-census-file 2xl:mr-80">
  <%= render "decidim/elections/vocdoni/admin/census_file/steps", current: :match %>

  <% if @form.errors[:blob].present? || @form.errors[:columns].present? %>
    <% messages = (@form.errors[:blob] + @form.errors[:columns]).join(" ") %>
    <%= cell "decidim/announcement", messages, callout_class: "alert" %>
  <% end %>

  <%= decidim_form_for(@form, url: wizard_path(:collection), method: :patch, html: { id: "js-census-file-mapping-form", class: "form-defaults form" }) do |f| %>
    <%= f.hidden_field :blob, value: @form.blob %>

    <div class="card vocdoni-census-file__card">
      <div class="card-divider">
        <h2 class="card-title"><%= t("title", scope:) %></h2>
      </div>

      <div class="card-section">
        <div class="row column">
          <p class="vocdoni-census-file__lead">
            <%= t("intro.columns", scope:, count: @form.headers.size) %>
            <%= t("intro.people", scope:, count: @form.reader.row_count) %>
          </p>
          <p class="vocdoni-census-file__lead"><%= t("intro.help", scope:) %></p>

          <% if @form.reader.truncated? %>
            <p class="vocdoni-census-file__note">
              <%= icon "information-line" %>
              <span><%= t("truncated_notice", scope:) %></span>
            </p>
          <% end %>
        </div>

        <div class="row column">
          <div class="table-stacked vocdoni-census-file__mapping-table"
               id="js-census-file-mapping-table"
               data-identity-fields="<%= Decidim::Elections::Vocdoni::CensusCsv::Fields::IDENTITY.join(" ") %>">
            <table>
              <caption class="sr-only"><%= t("title", scope:) %></caption>
              <thead>
                <tr>
                  <th scope="col"><%= t("column_header", scope:) %></th>
                  <th scope="col"><%= t("examples_header", scope:) %></th>
                  <th scope="col"><%= t("meaning_header", scope:) %></th>
                </tr>
              </thead>
              <tbody>
                <% @form.headers.each_with_index do |header, index| %>
                  <%
                    label_text = header.presence || t("column_placeholder", scope:, number: index + 1)
                    select_id = "census_file_columns_#{index}"
                    samples = @form.reader.column_samples(index, 3)
                  %>
                  <tr data-column-row="<%= index %>">
                    <td data-label="<%= t("column_header", scope:) %>"><strong><%= label_text %></strong></td>
                    <td data-label="<%= t("examples_header", scope:) %>">
                      <% if samples.present? %>
                        <span class="vocdoni-census-file__samples"><%= samples.join(", ") %></span>
                      <% else %>
                        <span class="vocdoni-census-file__samples vocdoni-census-file__samples--empty">
                          <span aria-hidden="true">—</span>
                          <span class="sr-only"><%= t("no_examples", scope:) %></span>
                        </span>
                      <% end %>
                    </td>
                    <td data-label="<%= t("meaning_header", scope:) %>">
                      <label class="sr-only" for="<%= select_id %>"><%= t("meaning_select_label", scope:, column: label_text) %></label>
                      <%= select_tag "census_file[columns][#{index}]",
                                     options_for_select(target_options, @form.selected(index)),
                                     id: select_id,
                                     class: "vocdoni-census-file__select",
                                     data: { column_select: index } %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <p class="vocdoni-census-file__note" id="js-census-file-identity-hint" <%= "hidden" unless @form.lacks_identity? %>>
            <%= icon "shield-keyhole-line" %>
            <span><%= t("identity_warning", scope:) %></span>
          </p>
        </div>
      </div>
    </div>

    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%= link_to t("back", scope:), wizard_path(:new), class: "button button__sm button__transparent-secondary" %>
        <%= f.submit t("submit", scope:, count: @form.reader.row_count), class: "button button__sm button__secondary" %>
      </div>
    </div>
  <% end %>
</div>
