<%#
  "How do voters actually reach this?"

  Publishing an election on the blockchain does NOT make it visible to
  participants. Three separate things have to be true before anybody can vote,
  and an admin who has just completed the irreversible on-chain step has every
  reason to assume they are done. This panel makes the remaining steps explicit
  and, once they are met, hands over the link to share.

  Expects a local `election`.
%>
<% component_published = election.component.published? %>
<% election_published = election.published? %>
<% votable = component_published && election_published && election.ongoing? %>
<% public_url = Decidim::ResourceLocatorPresenter.new(election).url %>
<%# The link an organiser puts in an email. Nil until the election is on chain,
    in which case only the public page is offered — which is honest, since there
    is no ballot to open yet. %>
<% direct_url = vocdoni_direct_voting_url(election) %>

<div class="card" id="js-vocdoni-public-link">
  <div class="card-divider">
    <h2 class="card-title">
      <%= icon "external-link-line", role: "img", "aria-hidden": true, class: "inline fill-current" %>
      <%= t("decidim.elections.vocdoni.admin.public_link.title") %>
    </h2>
  </div>

  <div class="card-section space-y-4">
    <% if votable %>
      <p class="text-sm"><%= t("decidim.elections.vocdoni.admin.public_link.ready") %></p>

      <%# Two links, and the difference between them matters: an organiser
          picking the wrong one either sends voters somewhere with no context or
          buries the ballot behind a page they have to read first. Each is
          labelled with what it opens rather than with what it is called. %>
      <div>
        <h3 class="h6 mb-1"><%= t("decidim.elections.vocdoni.admin.public_link.public_title") %></h3>
        <p class="text-sm text-gray-2 mb-2"><%= t("decidim.elections.vocdoni.admin.public_link.public_body") %></p>

        <div class="flex flex-wrap items-center gap-2">
          <label class="sr-only" for="js-vocdoni-public-url"><%= t("decidim.elections.vocdoni.admin.public_link.url_label") %></label>
          <%# Not a field the admin fills in — it exists to be read and copied —
              so autocomplete is switched off rather than left to the browser. %>
          <input id="js-vocdoni-public-url"
                 class="input flex-1 min-w-0"
                 type="text"
                 readonly
                 autocomplete="off"
                 value="<%= public_url %>"
                 data-vocdoni-public-url>

          <button type="button"
                  class="button button__sm button__secondary"
                  data-vocdoni-copy-url="js-vocdoni-public-url">
            <%= t("decidim.elections.vocdoni.admin.public_link.copy") %>
            <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.public_title") %></span>
          </button>

          <%# `data-external-domain-link="false"` opts this link out of Decidim's
              external-link interstitial. Core rewrites outbound anchors to warn
              before leaving the site, but it decides "outbound" from the request
              host — so on any installation reached through a different host than
              the organization's own (a proxy, a secondary host), an admin is
              warned about "an external link" to their own public page. %>
          <%= link_to public_url,
                      target: "_blank",
                      rel: "noopener",
                      data: { "external-domain-link": "false" },
                      class: "button button__sm button__transparent-secondary" do %>
            <%= t("decidim.elections.vocdoni.admin.public_link.open") %>
            <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.opens_new_tab") %></span>
          <% end %>
        </div>
      </div>

      <% if direct_url.present? %>
        <div>
          <h3 class="h6 mb-1"><%= t("decidim.elections.vocdoni.admin.public_link.direct_title") %></h3>
          <p class="text-sm text-gray-2 mb-2"><%= t("decidim.elections.vocdoni.admin.public_link.direct_body") %></p>

          <div class="flex flex-wrap items-center gap-2">
            <label class="sr-only" for="js-vocdoni-direct-url"><%= t("decidim.elections.vocdoni.admin.public_link.direct_url_label") %></label>
            <input id="js-vocdoni-direct-url"
                   class="input flex-1 min-w-0"
                   type="text"
                   readonly
                   autocomplete="off"
                   value="<%= direct_url %>"
                   data-vocdoni-direct-url>

            <button type="button"
                    class="button button__sm button__secondary"
                    data-vocdoni-copy-url="js-vocdoni-direct-url">
              <%= t("decidim.elections.vocdoni.admin.public_link.copy") %>
              <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.direct_title") %></span>
            </button>

            <%= link_to direct_url,
                        target: "_blank",
                        rel: "noopener",
                        data: { "external-domain-link": "false" },
                        class: "button button__sm button__transparent-secondary" do %>
              <%= t("decidim.elections.vocdoni.admin.public_link.open") %>
              <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.opens_new_tab") %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <p class="text-sm text-gray-2" role="status" data-vocdoni-copy-feedback></p>

      <p class="text-sm text-gray-2"><%= t("decidim.elections.vocdoni.admin.public_link.who_can_vote") %></p>
    <% else %>
      <%= cell "decidim/announcement",
               t("decidim.elections.vocdoni.admin.public_link.not_reachable"),
               callout_class: "warning" %>

      <%# The tick and the cross are the only thing that separates a step that is
          done from one that is not, and they are `aria-hidden` — so all three
          steps read as statements of fact ("The component is published") to a
          screen reader, whatever their state. Each one says which it is. %>
      <ol class="space-y-3 text-sm">
        <li class="flex items-start gap-2">
          <%= icon(component_published ? "check-line" : "close-circle-line",
                   role: "img", "aria-hidden": true,
                   class: "inline fill-current #{component_published ? "text-success" : "text-alert"}") %>
          <span>
            <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.#{component_published ? "step_done" : "step_missing"}") %>:</span>
            <strong><%= t("decidim.elections.vocdoni.admin.public_link.step_component") %></strong>
            <% unless component_published %>
              <br>
              <%= link_to t("decidim.elections.vocdoni.admin.public_link.step_component_action"),
                          Decidim::EngineRouter.admin_proxy(election.component.participatory_space).components_path,
                          class: "underline" %>
            <% end %>
          </span>
        </li>

        <li class="flex items-start gap-2">
          <%= icon(election_published ? "check-line" : "close-circle-line",
                   role: "img", "aria-hidden": true,
                   class: "inline fill-current #{election_published ? "text-success" : "text-alert"}") %>
          <span>
            <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.#{election_published ? "step_done" : "step_missing"}") %>:</span>
            <strong><%= t("decidim.elections.vocdoni.admin.public_link.step_election") %></strong>
            <% if !election_published && allowed_to?(:publish, :election, election:) %>
              <br>
              <%= link_to t("decidim.elections.vocdoni.admin.public_link.step_election_action"),
                          publish_election_path(election),
                          method: :put,
                          class: "underline" %>
            <% end %>
          </span>
        </li>

        <li class="flex items-start gap-2">
          <%= icon(election.ongoing? ? "check-line" : "close-circle-line",
                   role: "img", "aria-hidden": true,
                   class: "inline fill-current #{election.ongoing? ? "text-success" : "text-alert"}") %>
          <span>
            <span class="sr-only"><%= t("decidim.elections.vocdoni.admin.public_link.#{election.ongoing? ? "step_done" : "step_missing"}") %>:</span>
            <strong><%= t("decidim.elections.vocdoni.admin.public_link.step_open") %></strong>
          </span>
        </li>
      </ol>
    <% end %>
  </div>
</div>
