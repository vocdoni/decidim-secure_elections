<%#
  Alert on upstream's Dashboard tab when the last publish attempt failed
  (Process#failed?). A refused payment (Process#billing_failure?) gets its
  own message, since the admin cannot fix it from Decidim; any other error
  shows the SaaS text. The retry button re-enqueues PublishElectionJob,
  which resumes from the first step not yet done upstream.

  Rendered from the security card partial, before that card. Disappears once
  a retry succeeds and the state moves to published.
%>
<% process = election.vocdoni_process %>
<% if process&.failed? %>
  <% scope = "decidim.elections.vocdoni.admin.dashboard.publish_failure" %>
  <div class="callout alert vocdoni-publish-failure" role="alert">
    <p class="font-bold"><%= t("title", scope:) %></p>
    <% if process.billing_failure? %>
      <p class="vocdoni-publish-failure__billing">
        <% amount = process.billing_required_eur %>
        <%= amount ? t("billing_with_amount", scope:, amount: number_to_currency(amount, unit: "€", format: "%n %u")) : t("billing", scope:) %>
      </p>
    <% else %>
      <% if process.last_error.present? %>
        <p><%= t("error", scope:, message: process.last_error) %></p>
      <% end %>
      <p><%= t("hint", scope:) %></p>
    <% end %>
    <%= button_to t("retry", scope:),
                  Decidim::EngineRouter.admin_proxy(election.component).election_publish_retry_path(election),
                  method: :post,
                  class: "button button__sm button__secondary vocdoni-publish-failure__retry",
                  form: { data: { turbo: false } } %>
  </div>
<% end %>
