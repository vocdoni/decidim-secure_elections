<%#
  "Census for the secret vote" card on upstream's Dashboard tab, after the
  Census card of an unpublished election that opted in to Vocdoni.

  Publishing registers the census as it is at that moment; anyone who joins
  it afterwards (e.g. a participant who gets verified later) cannot vote, so
  the admin sees the count that will be registered before publishing.
%>
<% if election.vocdoni_process.present? %>
  <% count = census_count(election) %>
  <% scope = "decidim.elections.vocdoni.admin.dashboard.census_snapshot" %>
  <div class="card vocdoni-census-snapshot" data-census-count="<%= count %>">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold"><%= t("title", scope:) %></span>
      </h2>
    </div>

    <div class="card-section">
      <div class="row column">
        <% if count.zero? %>
          <div class="callout alert" role="alert">
            <p><%= t("empty", scope:) %></p>
          </div>
        <% else %>
          <p class="mb-2"><%= t("count", scope:, count:) %></p>
        <% end %>
        <p class="mb-2"><%= t("late_joiners", scope:) %></p>
        <% if election.census&.name.to_s == "internal_users" %>
          <p class="text-gray-2 text-sm"><%= t("verify_before_publishing", scope:) %></p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
