<%#
  "Census for the secret vote" card on upstream's Dashboard tab, for an
  opted-in election whose voting has not started: after the Census card while
  unpublished, after the security card once published.

  `PublishElectionJob` registers the census as it is when voting starts (at
  `start_at`, or when the admin clicks Start); anyone who joins it afterwards
  (e.g. a participant verified later) cannot vote, so the admin sees the
  current count and that limitation beforehand.
%>
<% process = election.vocdoni_process %>
<% if process.present? && !process.published? && !election.started? %>
  <% count = census_count(election) %>
  <% scope = "decidim.elections.vocdoni.admin.dashboard.census_snapshot" %>
  <div class="card vocdoni-census-snapshot" data-census-count="<%= count %>">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold"><%= t("title", scope:) %></span>
      </h2>
    </div>

    <div class="card-section">
      <div class="row column">
        <% if count.zero? %>
          <div class="callout alert" role="alert">
            <p><%= t("empty", scope:) %></p>
          </div>
        <% else %>
          <p class="mb-2"><%= t("count", scope:, count:) %></p>
        <% end %>
        <p class="mb-2"><%= t("limitations", scope:) %></p>
        <ul class="list-disc ml-6">
          <li><%= t("late_joiners", scope:) %></li>
          <% if election.census&.name.to_s == "internal_users" %>
            <li><%= t("verify_before_start", scope:) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
