<%# The census screens use the admin pack for the member rows, the live
    security meter and the credential limit. %>
<% append_javascript_pack_tag "decidim_elections_vocdoni_admin" %>

<% add_decidim_page_title(t("decidim.elections.vocdoni.admin.census.members.title")) %>

<%= render partial: "decidim/elections/vocdoni/admin/shared/election_header", locals: { election: } %>
<%= render partial: "nav", locals: { election: } %>

<%#
  The census, by hand.

  Rows are added and removed in the browser and saved together, so there is no
  page load between "add a person" and "add another". Without JavaScript the
  same page still works: a blank row is always rendered, and a row is removed
  by ticking its box and saving.

  Only the columns this election actually needs are shown. Asking for a
  national ID that nothing will ever read is how a census ends up half-filled.
%>
<%
  columns = election.census_columns
  required = election.required_member_fields
  alternatives = election.alternative_member_fields
  disabled = !election.editable?
%>

<% unless election.census_configured? %>
  <%= cell "decidim/announcement",
           { title: t("decidim.elections.vocdoni.admin.census.members.not_configured_title"),
             body: t("decidim.elections.vocdoni.admin.census.members.not_configured_body") },
           callout_class: "warning" %>
<% end %>

<%= decidim_form_for(@form, url: election_census_update_members_path(election), method: :patch,
                     html: { id: "js-census-members-form", class: "form-defaults form edit_census_members" }) do |form| %>

  <div class="card" id="js-census-members" data-columns="<%= columns.to_json %>">
    <div class="card-divider">
      <h2 class="card-title justify-between">
        <span class="text-black font-bold"><%= t("decidim.elections.vocdoni.admin.census.members.title") %></span>
        <% unless disabled %>
          <button type="button" class="button button__xs button__secondary" id="js-census-add-member">
            <%= icon "add-line", class: "!w-4 !h-4", aria_hidden: true %>
            <%= t("decidim.elections.vocdoni.admin.census.members.add") %>
          </button>
        <% end %>
      </h2>
    </div>

    <div class="card-section">
      <p class="text-sm text-gray-2 mb-4" id="js-census-members-help">
        <%= t("decidim.elections.vocdoni.admin.census.members.help") %>
        <% if alternatives.any? %>
          <%= t("decidim.elections.vocdoni.admin.census.members.alternatives_help",
                fields: alternatives.map { |field| Decidim::Elections::Vocdoni::CensusMember.field_label(field) }.to_sentence) %>
        <% end %>
      </p>

      <%#
        Only the errors that say something the flagged rows do not.

        `Decidim::AttributeObject::NestedValidator` adds a generic `:invalid`
        on `members` as soon as any row is invalid. Rendering it here put a
        second, softer sentence next to the flash — "some of the people below
        could not be saved" against "the census could not be saved" — and the
        save is all or nothing, so an admin could reasonably read that as "the
        valid ones went in" and walk away from a census that is still empty.
        The flash carries the one verdict; this banner is left for the errors
        that name a specific problem, such as a duplicated credential.
      %>
      <% member_errors = @form.errors.where(:members).reject { |error| error.type == :invalid } %>
      <% if member_errors.any? %>
        <%= cell "decidim/announcement", member_errors.map(&:message).to_sentence, callout_class: "alert" %>
      <% end %>

      <%#
        `table-stacked` is what makes each cell name itself on a phone: below
        `md` the header row is hidden and every `<td>` prints its `data-label`
        instead, above it the labels disappear and the header row does the
        naming. That is why no field here renders a label of its own — one
        column header per cell is enough, and two read as a stutter.
      %>
      <div class="table-scroll table-stacked">
        <table class="table-list" aria-describedby="js-census-members-help">
          <caption class="sr-only"><%= t("decidim.elections.vocdoni.admin.census.members.table_caption") %></caption>
          <thead>
            <tr>
              <% columns.each do |field| %>
                <th scope="col">
                  <%= Decidim::Elections::Vocdoni::CensusMember.field_label(field) %>
                  <% if required.include?(field) %>
                    <abbr title="<%= t("decidim.elections.vocdoni.admin.census.members.required") %>" aria-hidden="true">*</abbr>
                  <% end %>
                </th>
              <% end %>
              <th scope="col"><%= t("decidim.elections.vocdoni.admin.census.members.remove") %></th>
            </tr>
          </thead>

          <tbody id="js-census-members-rows">
            <% @form.members.each_with_index do |member, index| %>
              <%= fields_for "census[members][#{index}]", member do |member_form| %>
                <%= render partial: "member_row",
                           locals: { f: member_form, member:, columns:, required:, disabled:, row: index + 1 } %>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%#
        The blueprint the "Add" button clones. `%index%` is replaced with a
        fresh number so every new row submits under its own key — a `[]`
        collection would be split apart by the hidden field of the remove
        checkbox.
      %>
      <% unless disabled %>
        <template id="js-census-member-template">
          <%= fields_for "census[members][%index%]", Decidim::Elections::Vocdoni::Admin::CensusMemberForm.new do |member_form| %>
            <%= render partial: "member_row",
                       locals: { f: member_form, member: Decidim::Elections::Vocdoni::Admin::CensusMemberForm.new,
                                 columns:, required:, disabled: false, row: "%row%" } %>
          <% end %>
        </template>
      <% end %>
    </div>
  </div>

  <div class="item__edit-sticky">
    <div class="item__edit-sticky-container">
      <% if disabled %>
        <%= link_to t("decidim.elections.vocdoni.admin.census.members.back"), election_census_path(election), class: "button button__sm button__secondary" %>
      <% else %>
        <%= link_to t("decidim.elections.vocdoni.admin.census.members.back"), election_census_path(election), class: "button button__sm button__transparent-secondary" %>
        <%= form.submit t("decidim.elections.vocdoni.admin.census.members.save"), class: "button button__sm button__secondary" %>
      <% end %>
    </div>
  </div>
<% end %>
