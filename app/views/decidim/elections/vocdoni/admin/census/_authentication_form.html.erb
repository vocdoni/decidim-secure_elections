<%#
  Voter authentication — the Vocdoni app's three-part dialog
  (`Process/Create/VoterAuthentication/`).

  The app puts Credentials → Two-Factor → Summary behind tabs that unlock one
  after the other. Here they are three stacked sections instead: the semantics
  are identical, everything is reachable by keyboard in document order, and the
  summary is visible while the choices above it are still being made — which is
  the point of a summary. JavaScript keeps the meter and the counter in step;
  without it the form still submits and the server renders the same numbers.
%>
<%
  disabled = !election.editable?
  advice = @form.credentials_advice
%>

<div class="form__wrapper" id="js-census-authentication"
     data-max-credentials="<%= @form.max_credentials %>">

  <%# ─── 1. Credentials ─────────────────────────────────────────────── %>
  <div class="card">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold">
          <span aria-hidden="true">1.</span>
          <%= t("decidim.elections.vocdoni.admin.census.credentials.title") %>
        </span>
      </h2>
    </div>

    <div class="card-section">
      <fieldset aria-describedby="census-credentials-help">
        <legend class="h6"><%= t("decidim.elections.vocdoni.admin.census.credentials.legend") %></legend>
        <p class="help-text" id="census-credentials-help">
          <%= t("decidim.elections.vocdoni.admin.census.credentials.help", count: @form.max_credentials) %>
        </p>

        <%= form.collection_check_boxes :credentials, @form.available_credentials, :to_s, :to_s, { include_hidden: true } do |field| %>
          <div class="mb-1">
            <%= field.label do %>
              <%= field.check_box(disabled: disabled, data: { "census-credential": field.value }) %>
              <%= Decidim::Elections::Vocdoni::CensusMember.field_label(field.value) %>
            <% end %>
          </div>
        <% end %>

        <p class="text-sm text-gray-2 mt-2"
           id="js-census-credentials-count"
           role="status"
           data-template="<%= t("decidim.elections.vocdoni.admin.census.credentials.count", selected: "%selected%", max: "%max%") %>">
          <%= t("decidim.elections.vocdoni.admin.census.credentials.count",
                selected: @form.auth_fields.size, max: @form.max_credentials) %>
        </p>
      </fieldset>

      <%#
        The app's inline advice: one field earns a nudge, two or more a
        reassurance, none says nothing at all. Both are rendered and the
        browser only chooses which is visible — composing translated prose in
        JavaScript is how it ends up untranslated.
      %>
      <div class="mt-4" data-census-advice="recommend" <%= "hidden" unless advice == :recommend %>>
        <%= cell "decidim/announcement",
                 { title: t("decidim.elections.vocdoni.admin.census.credentials.advice.recommend_title"),
                   body: t("decidim.elections.vocdoni.admin.census.credentials.advice.recommend_body") },
                 callout_class: "secondary" %>
      </div>

      <div class="mt-4" data-census-advice="good" <%= "hidden" unless advice == :good %>>
        <%= cell "decidim/announcement",
                 { title: t("decidim.elections.vocdoni.admin.census.credentials.advice.good_title"),
                   body: t("decidim.elections.vocdoni.admin.census.credentials.advice.good_body") },
                 callout_class: "success" %>
      </div>
    </div>
  </div>

  <%# ─── 2. Two-factor ──────────────────────────────────────────────── %>
  <div class="card mt-4">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold">
          <span aria-hidden="true">2.</span>
          <%= t("decidim.elections.vocdoni.admin.census.two_factor.title") %>
        </span>
      </h2>
    </div>

    <div class="card-section">
      <fieldset aria-describedby="census-two-factor-help">
        <legend class="h6"><%= t("decidim.elections.vocdoni.admin.census.two_factor.legend") %></legend>
        <p class="help-text" id="census-two-factor-help"><%= t("decidim.elections.vocdoni.admin.census.two_factor.help") %></p>

        <% @form.available_two_factor_methods.each do |method| %>
          <div class="mb-2">
            <%#
              `label: false` because the form builder appends a label of its
              own, built from the option *key*: without it every option read
              itself out twice — "Email Email verification", "Sms SMS
              verification", "Voter choice Voter's choice". The label wrapping
              the input here is the only one, and it carries the translated
              name.
            %>
            <label for="<%= "census_two_factor_method_#{method}" %>">
              <%= form.radio_button :two_factor_method, method,
                                    id: "census_two_factor_method_#{method}",
                                    label: false,
                                    disabled: disabled,
                                    data: { "census-two-factor": method } %>
              <span class="font-semibold"><%= t(method, scope: "decidim.elections.vocdoni.admin.census.two_factor.methods") %></span>
            </label>
            <p class="help-text ml-6">
              <%= t(method, scope: "decidim.elections.vocdoni.admin.census.two_factor.descriptions") %>
            </p>
          </div>
        <% end %>
      </fieldset>

      <%#
        Verified upstream and worth spelling out: with 2FA on, the contact value
        is part of the voter's identity. A member without it cannot vote, and a
        right-credentials / wrong-contact attempt is refused with
        `40029 census participant not found` (ARCHITECTURE §4c-bis).
      %>
      <div id="js-census-two-factor-note" class="mt-4" <%= "hidden" unless @form.two_fa? %>>
        <%= cell "decidim/announcement",
                 { title: t("decidim.elections.vocdoni.admin.census.two_factor.contact_required_title"),
                   body: t("decidim.elections.vocdoni.admin.census.two_factor.contact_required_body") },
                 callout_class: "warning" %>
      </div>
    </div>
  </div>

  <%# ─── 3. Summary ─────────────────────────────────────────────────── %>
  <div class="card mt-4">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold">
          <span aria-hidden="true">3.</span>
          <%= t("decidim.elections.vocdoni.admin.census.summary.title") %>
        </span>
      </h2>
    </div>

    <div class="card-section">
      <div class="mb-4">
        <%= form.check_box :weighted,
                           disabled: disabled,
                           label: t("decidim.elections.vocdoni.admin.census.summary.weighted_label"),
                           help_text: t("decidim.elections.vocdoni.admin.census.summary.weighted_help") %>
      </div>

      <h3 class="h6"><%= t("decidim.elections.vocdoni.admin.census.summary.security") %></h3>
      <%= render partial: "security_meter", locals: { level: @form.security_level, id_prefix: "census-security-live" } %>
    </div>
  </div>

  <% if disabled %>
    <div class="mt-4">
      <%= cell "decidim/announcement", t("decidim.elections.vocdoni.admin.census.locked_on_chain"), callout_class: "warning" %>
    </div>
  <% end %>
</div>
