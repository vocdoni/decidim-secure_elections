<%#
  Importing a census from a spreadsheet — the Vocdoni app's import dialog
  (`Memberbase/Members/MembersCsvManager.tsx`), which has two halves for a
  reason: a template whose headers match what the importer expects turns
  "which columns does it want?" into one click.

  The template defaults to exactly the columns this election needs, so the
  common path requires no thought at all.
%>
<details class="mb-6" id="js-census-import" <%= "open" if form.errors.any? %>>
  <summary class="cursor-pointer font-semibold py-2">
    <%= icon "upload-2-line", class: "!w-4 !h-4 inline-block", aria_hidden: true %>
    <%= t("decidim.elections.vocdoni.admin.census.import.title") %>
  </summary>

  <div class="pt-4 pl-2 border-l">
    <h3 class="h6"><%= t("decidim.elections.vocdoni.admin.census.import.template_title") %></h3>
    <p class="text-sm text-gray-2 mb-2"><%= t("decidim.elections.vocdoni.admin.census.import.template_help") %></p>

    <%# A GET form: the template is a pure function of the ticked boxes. %>
    <%= form_tag election_census_template_path(election), method: :get, class: "mb-6" do %>
      <fieldset>
        <legend class="sr-only"><%= t("decidim.elections.vocdoni.admin.census.import.template_columns") %></legend>
        <% Decidim::Elections::Vocdoni::CensusMember::FIELDS.each do |field| %>
          <% next if field == "weight" && !election.weighted? %>
          <div class="mb-1">
            <label for="<%= "census-template-#{field}" %>">
              <%= check_box_tag "fields[]", field, election.census_columns.include?(field),
                                id: "census-template-#{field}" %>
              <%= Decidim::Elections::Vocdoni::CensusMember.field_label(field) %>
            </label>
          </div>
        <% end %>
      </fieldset>

      <%= submit_tag t("decidim.elections.vocdoni.admin.census.import.download_template"),
                     class: "button button__xs button__transparent-secondary mt-2",
                     name: nil %>
    <% end %>

    <h3 class="h6"><%= t("decidim.elections.vocdoni.admin.census.import.file_title") %></h3>
    <p class="text-sm text-gray-2 mb-2" id="census-import-file-help">
      <%= t("decidim.elections.vocdoni.admin.census.import.file_help") %>
    </p>

    <%
      # What the upload modal says about the file it is asking for.
      #
      # Built here rather than left to `help_i18n_scope`, because the useful
      # half of it is per-election. Decidim's generic `import_csv` scope reads
      # ".csv file with email data" — and this census may well have no email
      # column at all, so the one piece of guidance the admin was given was
      # both wrong and impossible to satisfy.
      column_labels = election.census_columns.map { |field| Decidim::Elections::Vocdoni::CensusMember.field_label(field) }
      required_labels = election.required_member_fields.map { |field| Decidim::Elections::Vocdoni::CensusMember.field_label(field) }
      upload_help = [t("decidim.elections.vocdoni.admin.census.import.guidance.format")]
      upload_help << t("decidim.elections.vocdoni.admin.census.import.guidance.columns", columns: column_labels.to_sentence) if column_labels.any?
      upload_help << t("decidim.elections.vocdoni.admin.census.import.guidance.required", fields: required_labels.to_sentence) if required_labels.any?
      # Stated before it is enforced. Both ceilings are ones an admin can
      # actually hit, and both refuse rather than truncate. The size quoted is
      # whichever is smaller of this importer's own limit and the
      # organization's upload setting — promising 25 MB on a platform
      # configured for 10 would be the same kind of wrong as the column
      # guidance this replaced.
      upload_help << t("decidim.elections.vocdoni.admin.census.import.guidance.size",
                       limit: number_to_human_size(Decidim::Elections::Vocdoni::Admin::CensusImportForm.effective_max_file_size(current_organization)),
                       rows: number_with_delimiter(Decidim::Elections::Vocdoni::CensusCsv::MAX_ROWS))
      upload_help << t("decidim.elections.vocdoni.admin.census.import.guidance.rows")

      census_size = election.census_members.size
    %>

    <%= decidim_form_for(form, url: election_census_import_path(election), method: :post,
                         html: { id: "js-census-import-form", class: "form-defaults form new_census_import", multipart: true }) do |f| %>
      <div class="mb-2">
        <%= f.upload :file, help: upload_help,
                            help_i18n_scope: "decidim.elections.vocdoni.admin.census.import.guidance",
                            button_class: "button button__sm button__transparent-secondary" %>
      </div>

      <div class="mb-2">
        <%#
          Off by default: a census wiped by a stray second upload cannot be
          recovered from this screen.

          The confirmation lives on the submit button, not here. Decidim's
          confirm dialog is wired to link clicks, form submits and submit
          buttons — a checkbox matches none of those selectors, so a
          `data-confirm` on this input was read by nothing at all and the most
          destructive routine action on the census had no confirmation
          whatsoever. The count travels with it, the way "Empty the census"
          does, because "this will remove the 7 people currently in the
          census" is a different sentence from "this will replace the census".
        %>
        <%= f.check_box :replace,
                        label: t("decidim.elections.vocdoni.admin.census.import.replace_label"),
                        help_text: t("decidim.elections.vocdoni.admin.census.import.replace_help"),
                        data: { "census-import-replace": true,
                                "confirm-message": t("decidim.elections.vocdoni.admin.census.import.replace_confirm", count: census_size),
                                "confirm-title": t("decidim.elections.vocdoni.admin.census.import.replace_confirm_title") } %>
      </div>

      <%#
        No `data-confirm` server-side: it is only correct while the box above
        is ticked, and the browser is the only thing that knows that. Without
        JavaScript there is no confirm dialog at all — the dialog itself is
        JavaScript — but the checkbox still says what it does and the flash
        afterwards now names the people it removed.
      %>
      <%= f.submit t("decidim.elections.vocdoni.admin.census.import.submit"),
                   class: "button button__xs button__secondary",
                   id: "js-census-import-submit",
                   data: { "confirm-icon": "alert-line" } %>
    <% end %>
  </div>
</details>
