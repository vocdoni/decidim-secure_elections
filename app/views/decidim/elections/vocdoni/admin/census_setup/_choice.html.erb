<%#
  Card 1: where the list of voters comes from.

  Same card as the Security tab's vote-type question: radio labelled by the
  title only, the rest of the card describing it (`aria-describedby`), so a
  screen reader announces "Registered participants, radio" and can then hear
  what that means. The radio is `manifest`, the name upstream's controller
  reads.

  Switching away from an uploaded list destroys it. The confirmation on Save
  is what asks about that, once, rather than the card warning about it before
  anything has been chosen.

  Locals: `chosen` (the census type currently selected, "" when none).
%>
<% scope = "decidim.elections.vocdoni.admin.census_setup.choice" %>
<%
  options = {
    "internal_users" => { icon: "group-2-line", points: %w(nothing_to_upload open_list verification) },
    "token_csv" => { icon: "bill-line", points: %w(exact typed frozen code) }
  }
  point_icons = {
    "nothing_to_upload" => "check-line",
    "open_list" => "refresh-line",
    "verification" => "shield-check-line",
    "exact" => "list-check",
    "typed" => "fingerprint-line",
    "frozen" => "lock-2-line",
    "code" => "mail-lock-line"
  }
%>
<div class="card vocdoni-census__card">
  <div class="card-divider">
    <h2 class="card-title" id="census-choice-title"><%= t("legend", scope:) %></h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <fieldset id="js-census-choice"
                class="vocdoni-census__fieldset"
                aria-labelledby="census-choice-title"
                aria-describedby="census-choice-lead">
        <p class="vocdoni-census__lead" id="census-choice-lead"><%= t("lead", scope:) %></p>

        <div class="vocdoni-choices">
          <% options.each do |value, option| %>
            <% selected = chosen == value %>
            <div class="vocdoni-choice<%= " is-selected" if selected %>" data-census-choice-card="<%= value %>">
              <div class="vocdoni-choice__header">
                <%= radio_button_tag "manifest", value, selected,
                                     id: "census_manifest_#{value}",
                                     class: "vocdoni-choice__input",
                                     aria: { describedby: "census-choice-#{value}-description" },
                                     data: { census_choice: value } %>
                <span class="vocdoni-choice__icon" aria-hidden="true"><%= icon option[:icon] %></span>
                <label for="census_manifest_<%= value %>" class="vocdoni-choice__title">
                  <%= t("#{value}.title", scope:) %>
                </label>
              </div>

              <div class="vocdoni-choice__body" id="census-choice-<%= value %>-description">
                <p class="vocdoni-choice__summary"><%= t("#{value}.summary", scope:) %></p>

                <ul class="vocdoni-choice__points">
                  <% option[:points].each do |key| %>
                    <li>
                      <%= icon point_icons[key], class: "vocdoni-choice__point-icon" %>
                      <span><%= t("#{value}.points.#{key}", scope:) %></span>
                    </li>
                  <% end %>
                </ul>

                <p class="vocdoni-choice__best">
                  <strong><%= t("best_for", scope:) %></strong>
                  <%= t("#{value}.best_for", scope:) %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      </fieldset>
    </div>
  </div>
</div>
