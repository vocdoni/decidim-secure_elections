<%#
  Set-up for "Participants from a file".

  Nothing is edited here: the file is uploaded, read and imported on one page
  of its own (`Admin::CensusFileController`), which also asks which of its
  details voters type to be found on the list. This block is the way in, and
  the state of what was done.

  Two states — no list yet (what it takes, and a template), and a list (who is
  on it, how they are identified, and how to replace or remove it).

  Locals: `chosen`.
%>
<% scope = "decidim.elections.vocdoni.admin.census_setup.file" %>
<% fields_mod = Decidim::Elections::Vocdoni::CensusCsv::Fields %>
<% settings = election.census_settings.to_h %>
<% shown = chosen == "token_csv" %>
<%
  # The real count, not the figure stored at import time, which goes stale.
  people_count = census_voters_count
  kept_fields = census_columns(election)
  identifier_labels = census_identifier_labels(election)
  # This engine's own routes only resolve inside upstream's admin engine;
  # the proxy builds them from the component wherever this renders.
  admin = Decidim::EngineRouter.admin_proxy(election.component)
%>
<div class="card vocdoni-census__card vocdoni-census-file"
     data-census-block="token_csv"
     <%= "hidden" unless shown %>>
  <div class="card-divider">
    <h2 class="card-title"><%= t("legend", scope:) %></h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <% if people_count.zero? %>
        <p class="vocdoni-census__lead"><%= t("empty.lead", scope:) %></p>

        <p class="vocdoni-census__lead"><%= t("empty.next", scope:) %></p>

        <details class="vocdoni-census__details">
          <summary class="vocdoni-census__details-summary"><%= t("empty.fields_title", scope:) %></summary>
          <ul class="vocdoni-census__fields-grid">
            <% fields_mod::TARGETS.each do |field| %>
              <li class="vocdoni-census__fields-grid-item">
                <strong><%= fields_mod.label(field) %></strong>
                <span class="help-text"><%= fields_mod.hint(field) %></span>
              </li>
            <% end %>
          </ul>
        </details>

        <div class="vocdoni-census__actions">
          <%= link_to t("empty.download_template", scope:), admin.template_election_census_file_path(election),
                      class: "button button__sm button__transparent-secondary" %>
          <% if election.editable? %>
            <%= link_to t("empty.upload", scope:), admin.new_election_census_file_path(election),
                        class: "button button__sm button__secondary" %>
          <% end %>
        </div>
      <% else %>
        <p class="vocdoni-census__count">
          <%= icon "group-2-line" %>
          <span><%= t("status.people", scope:, count: people_count) %></span>
        </p>

        <p class="vocdoni-census__identifiers">
          <% if identifier_labels.any? %>
            <span><%= t("status.identified_by", scope:, fields: identifier_labels.to_sentence) %></span>
          <% else %>
            <span class="vocdoni-census__identifiers--missing"><%= t("status.no_identifiers", scope:) %></span>
          <% end %>
          <% if election.editable? %>
            <%= link_to t("status.change_identifiers", scope:), admin.identifiers_election_census_file_path(election),
                        class: "vocdoni-census__inline-link" %>
          <% end %>
        </p>

        <% if election.editable? %>
          <div class="vocdoni-census__actions">
            <%= link_to t("status.replace", scope:), admin.new_election_census_file_path(election),
                        class: "button button__sm button__transparent-secondary" %>
            <%= link_to t("status.remove", scope:), admin.election_census_file_path(election),
                        method: :delete,
                        class: "button button__sm button__transparent-secondary",
                        data: {
                          confirm: t("status.remove_confirm_body", scope:, count: people_count),
                          "confirm-title": t("status.remove_confirm_title", scope:)
                        } %>
          </div>
        <% else %>
          <p class="vocdoni-census__note">
            <%= icon "lock-2-line" %>
            <span><%= t("status.locked", scope:) %></span>
          </p>
        <% end %>

        <details class="vocdoni-census__details">
          <summary class="vocdoni-census__details-summary"><%= t("status.details", scope:) %></summary>
          <ul class="vocdoni-census__facts">
            <% if settings.dig("file", "name").present? %>
              <li><%= t("status.file", scope:, name: settings.dig("file", "name")) %></li>
            <% end %>
            <% if settings.dig("file", "imported_at").present? %>
              <li><%= t("status.imported_at", scope:, date: l(Time.zone.parse(settings.dig("file", "imported_at")), format: :short)) %></li>
            <% end %>
          </ul>

          <% if kept_fields.any? %>
            <p class="vocdoni-census__facts-title"><%= t("status.columns", scope:) %></p>
            <ul class="vocdoni-census__pills">
              <% kept_fields.each do |field| %>
                <li class="vocdoni-census__pill"><%= fields_mod.label(field) %></li>
              <% end %>
            </ul>
          <% end %>

          <%# The table itself, not the `sample` partial: one disclosure holds
              everything about the list, rather than a disclosure inside a
              disclosure. %>
          <% rows = preview_users(election) %>
          <% if rows.present? %>
            <p class="vocdoni-census__facts-title"><%= t("status.sample", scope:, count: rows.size) %></p>
            <%= render partial: "decidim/elections/admin/census/preview", locals: { election: } %>
          <% end %>
        </details>
      <% end %>
    </div>
  </div>
</div>
