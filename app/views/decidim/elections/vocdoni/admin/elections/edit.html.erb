<%# The Main tab: title / description / calendar / results availability
    rendered as three collapsible accordion cards inside one form.

    Always reachable — and read-only, never hidden — once the process
    is on chain. %>
<% add_decidim_page_title(t(".title")) %>

<%= render partial: "decidim/elections/vocdoni/admin/shared/configuration_warning" %>
<%= render partial: "decidim/elections/vocdoni/admin/shared/election_header", locals: { election: } %>
<%= render "decidim/elections/vocdoni/admin/elections/tabs_menu" %>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for(@form,
                         url: election_path(election),
                         method: :patch,
                         html: { id: "basic-election-form-edit", class: "form-defaults form edit_election" }) do |f| %>
      <%= render partial: "decidim/elections/vocdoni/admin/elections/form", locals: { form: f, election: } %>
    <% end %>
  </div>
  <div class="item__edit-sticky">
    <div class="item__edit-sticky-container">
      <%= button_tag t("decidim.elections.vocdoni.admin.elections.save_and_continue"),
                     form: "basic-election-form-edit",
                     class: "button button__sm button__secondary" %>
    </div>
  </div>
</div>
