<% add_decidim_page_title(t(".title")) %>

<%= render partial: "decidim/elections/vocdoni/admin/shared/configuration_warning" %>

<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <% if allowed_to? :create, :election %>
        <%= link_to t("decidim.elections.vocdoni.admin.elections.new_election"), new_election_path, class: "button button__sm button__secondary" %>
      <% end %>
      <%= render partial: "decidim/admin/components/resource_action" %>
    </h1>
  </div>

  <%= admin_filter_selector(:vocdoni) %>

  <div class="table-stacked">
    <table class="table-list">
      <%= render partial: "elections-thead" %>
      <tbody>
        <%= render partial: "decidim/elections/vocdoni/admin/elections/election-tr",
                   collection: elections,
                   as: :election,
                   locals: { view: :index } %>
      </tbody>
    </table>
  </div>

  <% if elections.none? %>
    <p class="p-4 text-gray-2"><%= t(".empty") %></p>
  <% end %>

  <% if allowed_to? :manage_trash, :election %>
    <div class="card mt-4">
      <%= link_to manage_trash_elections_path, class: "flex items-center text-secondary" do %>
        <%= icon "delete-bin-2-line", class: "mr-2 fill-current text-secondary", role: "img" %>
        <%= t("decidim.elections.vocdoni.admin.elections.view_deleted") %>
        <span class="ml-2">
          <%= icon_with_tooltip("information-line", t("decidim.elections.vocdoni.admin.elections.deleted_election_info")) %>
        </span>
      <% end %>
    </div>
  <% end %>
</div>

<%= decidim_paginate elections %>
