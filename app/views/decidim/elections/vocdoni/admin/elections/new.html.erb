<%# New election. Renders the same three-card Main-tab layout as
    `edit.html.erb`, plus the tabs menu upstream shows on this screen
    (Main active, the other three disabled until the record exists).
    `end_at` is required at save time (see `ElectionForm`), so the admin
    can't submit a title-only draft and be dropped into a half-configured
    election. %>
<% add_decidim_page_title(t(".title")) %>

<%= render partial: "decidim/elections/vocdoni/admin/shared/configuration_warning" %>

<div class="item_show__header border-none">
  <h1 class="item_show__header-title"><%= t(".title") %></h1>
</div>

<%= render "decidim/elections/vocdoni/admin/elections/tabs_menu" %>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for(@form,
                         url: elections_path,
                         method: :post,
                         html: { id: "new-election-form", class: "form-defaults form new_election" }) do |f| %>
      <%= render partial: "decidim/elections/vocdoni/admin/elections/form", locals: { form: f, election: nil } %>

      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= f.submit t("decidim.elections.vocdoni.admin.elections.save_and_continue"), class: "button button__sm button__secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
