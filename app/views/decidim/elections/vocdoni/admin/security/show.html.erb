<%#
  Security tab, shown on every election between Census and Dashboard.

  1. How the vote runs — a simple Decidim vote or a secret, verifiable one
     on Vocdoni (`enable_vocdoni`; opting in creates the `Vocdoni::Process`
     sidecar), with the reasons an organisation would pick one or the other.
  2. How voters prove who they are (file census: 1–3 of its columns).
  3. The one-time code sent to voters of a secret vote (`twoFaFields`).
  4. What the secure voting service said about the list.
  5. A one-line summary of the resulting configuration.

  The server renders every state; `security.js` only keeps the page in step
  with unsaved changes.
%>
<% add_decidim_page_title(t(".title")) %>
<% append_javascript_pack_tag "decidim_elections_vocdoni_admin" %>
<% append_stylesheet_pack_tag "decidim_elections_vocdoni_admin", media: "all" %>

<div class="item_show__header border-none">
  <h1 class="item_show__header-title"><%= t(".title") %></h1>
</div>

<%# Upstream's tabs menu (admin_elections_menu), where the phase-4 spike
    injects the Security item. %>
<%= render "decidim/elections/admin/elections/tabs_menu" %>

<%# `vocdoni-cards` carries the selectable-card styles this page shares with
    the Census tab; `vocdoni-security` everything that is only this page's. %>
<div class="item__edit-form vocdoni-security vocdoni-cards 2xl:mr-80">
  <%# `request.path` is the URL bound to both #show and #update
      (`resource :security`). A string rather than the named helper because
      this view renders inside upstream's admin engine, whose url_helpers
      only learn about the injected route through method_missing. %>
  <%= decidim_form_for(@form,
                       url: request.path,
                       method: :put,
                       html: { id: "security-form", class: "form-defaults form" }) do |f| %>
    <%= render "decidim/elections/vocdoni/admin/security/choice", f: %>
    <%= render "decidim/elections/vocdoni/admin/security/identifiers" %>
    <%= render "decidim/elections/vocdoni/admin/security/two_factor", f: %>
    <%= render "decidim/elections/vocdoni/admin/security/validation" %>
    <%= render "decidim/elections/vocdoni/admin/security/summary" %>

    <div class="item__edit-sticky">
      <div class="item__edit-sticky-container">
        <%# Upstream's own label ("Save and continue"), as on Questions and
            Census; the controller continues the wizard onto Dashboard. %>
        <%= f.submit t("save", scope: "decidim.elections.admin.elections.form"),
                     id: "js-security-submit",
                     class: "button button__sm button__secondary" %>
      </div>
    </div>
  <% end %>
</div>
