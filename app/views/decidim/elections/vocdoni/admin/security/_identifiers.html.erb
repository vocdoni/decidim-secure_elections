<%#
  Card: how voters prove who they are — shown, not edited.

  The choice belongs to the census: a simple vote needs it just as much, and
  for registered participants the same question is answered by the
  verifications on the Census tab. So it is made there, and this card only
  reports it and points back.

  - "Participants from a file": the details the admin picked, with a link to
    change them, or a warning when the list has none yet.
  - "Registered participants": nothing to pick; what voters will be asked
    depends on the vote type, so both sentences are rendered and `security.js`
    shows the one that matches.
  - No census yet: a pointer to the Census tab.
%>
<% scope = "decidim.elections.vocdoni.admin.security.show.identifiers" %>
<% census_link = Decidim::EngineRouter.admin_proxy(election.component).census_election_path(election) %>
<div class="card vocdoni-security__card">
  <div class="card-divider">
    <h2 class="card-title" id="security-identifiers-title"><%= t("legend", scope:) %></h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <% if @form.file_census? && @form.identifiers.any? %>
        <p class="vocdoni-security__lead"><%= t("chosen", scope:, fields: @form.identifier_labels.to_sentence) %></p>

        <% if @form.secure_blocked_by_identifiers? %>
          <%= cell "decidim/announcement",
                   { title: t("refused.title", scope:),
                     body: t("refused.body", scope:, fields: @form.refused_identifier_labels.to_sentence) },
                   callout_class: "alert" %>
        <% elsif @form.refused_identifier_labels.any? %>
          <p class="vocdoni-security__note">
            <%= icon "information-line" %>
            <span><%= t("partly_refused", scope:, fields: @form.refused_identifier_labels.to_sentence, kept: @form.secure_identifiers.map { |field| Decidim::Elections::Vocdoni::CensusCsv::Fields.label(field) }.to_sentence) %></span>
          </p>
        <% end %>

        <%# A contact detail identifies a voter through the code sent to it,
            so saying only "they type their email" would be a half-truth. %>
        <% if @form.code_identifiers.any? %>
          <p class="vocdoni-security__note" data-identifiers-note="secure" <%= "hidden" unless @form.enable_vocdoni %>>
            <%= icon "mail-lock-line" %>
            <span><%= t("by_code", scope:, fields: @form.required_code_labels.to_sentence) %></span>
          </p>
        <% end %>

        <p class="vocdoni-security__note">
          <%= icon "information-line" %>
          <span><%= t("change_html", scope:, url: census_link) %></span>
        </p>
      <% elsif @form.file_census? %>
        <p class="vocdoni-security__note">
          <%= icon "error-warning-line" %>
          <span><%= t("none_html", scope:, url: census_link) %></span>
        </p>
      <% elsif @form.registered_census? %>
        <p class="vocdoni-security__lead"><%= t("registered.lead", scope:) %></p>
        <p class="vocdoni-security__note" data-identifiers-note="simple" <%= "hidden" if @form.enable_vocdoni %>>
          <%= icon "information-line" %>
          <span><%= t("registered.simple", scope:) %></span>
        </p>
        <p class="vocdoni-security__note" data-identifiers-note="secure" <%= "hidden" unless @form.enable_vocdoni %>>
          <%= icon "information-line" %>
          <span><%= t("registered.secure", scope:) %></span>
        </p>
      <% else %>
        <p class="vocdoni-security__note">
          <%= icon "information-line" %>
          <span><%= t("no_census_html", scope:, url: census_link) %></span>
        </p>
      <% end %>
    </div>
  </div>
</div>
