<%#
  Card: how voters prove who they are.

  - "Participants from a file": the admin ticks 1–3 of the file's columns.
    Which ones are allowed depends on the vote type (the secure voting
    service only accepts some details); each box carries both answers in
    `data-simple-ok` / `data-secure-ok` so `security.js` can follow the
    radio, and the server renders the state of the saved choice.
  - "Registered participants": nothing to choose; the card explains what
    voters will be asked.
  - No list yet: a pointer to the Census tab.
%>
<% scope = "decidim.elections.vocdoni.admin.security.show.identifiers" %>
<% fields = Decidim::Elections::Vocdoni::CensusCsv::Fields %>
<% census_link = Decidim::EngineRouter.admin_proxy(election.component).census_election_path(election) %>
<div class="card vocdoni-security__card">
  <div class="card-divider">
    <h2 class="card-title" id="security-identifiers-title"><%= t("legend", scope:) %></h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <% if @form.file_census_with_list? %>
        <% errors = @form.errors[:identifiers] %>
        <fieldset id="js-security-identifiers"
                  class="vocdoni-security__fieldset vocdoni-identifiers"
                  aria-labelledby="security-identifiers-title"
                  aria-describedby="security-identifiers-lead<%= " security-identifiers-error" if errors.any? %>"
                  data-max="<%= fields::MAX_IDENTIFIERS %>"
                  data-weak="<%= fields::WEAK.join(" ") %>">
          <p class="vocdoni-security__lead" id="security-identifiers-lead"><%= t("lead", scope:, max: fields::MAX_IDENTIFIERS) %></p>

          <% if errors.any? %>
            <p class="form-error is-visible" id="security-identifiers-error"><%= errors.to_sentence %></p>
          <% end %>

          <input type="hidden" name="security[identifiers][]" value="">
          <ul class="vocdoni-identifiers__list">
            <% @form.identifier_options.each do |field| %>
              <% simple_ok = @form.allowed_for_simple?(field) %>
              <% secure_ok = @form.allowed_for_secure?(field) %>
              <% allowed = @form.enable_vocdoni ? secure_ok : simple_ok %>
              <li class="vocdoni-identifiers__item<%= " is-unavailable" unless allowed %>"
                  data-identifier="<%= field %>"
                  data-simple-ok="<%= simple_ok %>"
                  data-secure-ok="<%= secure_ok %>">
                <label class="vocdoni-identifiers__label" for="security_identifiers_<%= field %>">
                  <input type="checkbox"
                         name="security[identifiers][]"
                         id="security_identifiers_<%= field %>"
                         value="<%= field %>"
                         aria-describedby="security-identifiers-<%= field %>-hint"
                         <%= "checked" if @form.identifier_selected?(field) %>
                         <%= "disabled" unless allowed %>>
                  <span><%= fields.label(field) %></span>
                </label>
                <p class="help-text vocdoni-identifiers__hint" id="security-identifiers-<%= field %>-hint">
                  <span data-identifier-hint="ok"><%= fields.hint(field) %></span>
                  <span data-identifier-hint="refused" <%= "hidden" if allowed %>><%= t("not_for_secure", scope:) %></span>
                </p>
              </li>
            <% end %>
          </ul>

          <div class="vocdoni-identifiers__weak" data-identifiers-weak <%= "hidden" unless @form.weak_identifiers? %>>
            <%= cell("decidim/announcement", t("weak", scope:), callout_class: "warning") %>
          </div>
        </fieldset>
      <% elsif @form.file_census? %>
        <p class="vocdoni-security__note">
          <%= icon "information-line" %>
          <span><%= t("no_list_html", scope:, url: census_link) %></span>
        </p>
      <% elsif @form.registered_census? %>
        <p class="vocdoni-security__lead"><%= t("registered.lead", scope:) %></p>
        <p class="vocdoni-security__note" data-identifiers-note="simple" <%= "hidden" if @form.enable_vocdoni %>>
          <%= icon "information-line" %>
          <span><%= t("registered.simple", scope:) %></span>
        </p>
        <p class="vocdoni-security__note" data-identifiers-note="secure" <%= "hidden" unless @form.enable_vocdoni %>>
          <%= icon "information-line" %>
          <span><%= t("registered.secure", scope:) %></span>
        </p>
      <% else %>
        <p class="vocdoni-security__note">
          <%= icon "information-line" %>
          <span><%= t("no_census_html", scope:, url: census_link) %></span>
        </p>
      <% end %>
    </div>
  </div>
</div>
