<%#
  Card: the one-time code (`twoFaFields`).

  Only meaningful for a secret vote, so the whole fieldset is `disabled`
  while the simple vote is selected; `security.js` flips it as the admin
  changes the vote type. Email and SMS are independent; with both on, the
  voter picks the channel when the code is requested.

  Each channel needs somewhere to send the code: a file census needs the
  matching column, and registered participants have an email address but no
  phone number. An unavailable channel is disabled and says why.

  A channel can also be *required* rather than chosen: when the census
  identifies people by their email or phone, the code sent there is what
  proves who they are, so it is on and cannot be turned off from here.
%>
<% scope = "decidim.elections.vocdoni.admin.security.show.two_factor" %>
<% enabled = @form.enable_vocdoni %>
<%
  channels = [
    { field: :email, census_field: "email", icon: "mail-lock-line", available: @form.email_code_available? },
    { field: :sms, census_field: "phone", icon: "smartphone-line", available: @form.sms_code_available? }
  ]
%>
<div class="card vocdoni-security__card">
  <div class="card-divider">
    <h2 class="card-title" id="security-two-factor-title"><%= t("legend", scope:) %></h2>
  </div>

  <div class="card-section">
    <div class="row column">
      <fieldset id="js-security-two-factor"
                class="vocdoni-security__fieldset vocdoni-two-factor"
                aria-labelledby="security-two-factor-title"
                aria-describedby="security-two-factor-lead"
                <%= "disabled" unless enabled %>>
        <p class="vocdoni-security__lead" id="security-two-factor-lead"><%= t("lead", scope:) %></p>

        <p class="vocdoni-security__note" data-two-factor-note="simple" <%= "hidden" if enabled %>>
          <%= icon "information-line" %>
          <span><%= t("simple_note", scope:) %></span>
        </p>

        <div class="vocdoni-two-factor__options">
          <% channels.each do |channel| %>
            <% field = channel[:field] %>
            <% required = @form.code_required?(channel[:census_field]) %>
            <div class="vocdoni-two-factor__option<%= " is-unavailable" unless channel[:available] %>">
              <div class="vocdoni-two-factor__control">
                <%# Required: rendered on and disabled, with a hidden field so
                    the choice still reaches the server. No id of its own —
                    it would collide with the checkbox's and steal its label. %>
                <%= hidden_field_tag "security[#{field}]", "1", id: nil if required %>
                <%= f.check_box field,
                                label: false,
                                id: "security_#{field}",
                                checked: required || nil,
                                disabled: required || !channel[:available],
                                aria: { describedby: "security-#{field}-help" },
                                data: { security_code: true } %>
                <label for="security_<%= field %>" class="vocdoni-two-factor__label">
                  <%= icon channel[:icon] %>
                  <span><%= t("#{field}.label", scope:) %></span>
                </label>
              </div>
              <p class="help-text vocdoni-two-factor__help" id="security-<%= field %>-help">
                <% if required %>
                  <%= t("#{field}.required", scope:) %>
                <% elsif channel[:available] %>
                  <%= t("#{field}.help", scope:) %>
                <% elsif @form.file_census? %>
                  <%= t("#{field}.needs_column", scope:) %>
                <% else %>
                  <%= t("#{field}.not_for_registered", scope:) %>
                <% end %>
              </p>
            </div>
          <% end %>
        </div>

        <p class="help-text vocdoni-two-factor__both"><%= t("both_note", scope:) %></p>
      </fieldset>
    </div>
  </div>
</div>
