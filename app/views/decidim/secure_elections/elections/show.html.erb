<% add_decidim_meta_tags(
     description: decidim_sanitize_translated(election.description),
     title: translated_attribute(election.title),
     url: election_url(election.id),
     resource: election
   ) %>

<% append_stylesheet_pack_tag "decidim_secure_elections", media: "all" %>
<% append_javascript_pack_tag "decidim_secure_elections", defer: true %>

<% content_for :aside do %>
  <%= render partial: "election_aside" %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_item", locals: { reference: resource_reference(election), back_path: elections_path } do %>
  <section class="layout-main__section layout-main__heading">
    <div class="vocdoni-election__meta mb-4">
      <%= cell("decidim/secure_elections/election_status", election) %>

      <%#
        Voting that is already open is described by when it closes, not by when
        it opened — and never by "publication", which is a word about the
        administrator's workflow that means nothing to a voter. The full range
        is still shown before voting starts and after it ends, where both ends
        of it are information the reader needs.
      %>
      <% if election.start_at.present? || election.end_at.present? %>
        <span>
          <%= icon "calendar-line", role: "img", "aria-hidden": true, class: "inline fill-current" %>
          <% if voting_open? && election.end_at.present? %>
            <%= t("decidim.secure_elections.elections.show.calendar_open",
                  end_date: l(election.end_at, format: :decidim_short)) %>
          <% elsif voting_open? %>
            <%= t("decidim.secure_elections.elections.show.calendar_open_no_end") %>
          <% else %>
            <%= t("decidim.secure_elections.elections.show.calendar",
                  start_date: election.start_at.present? ? l(election.start_at, format: :decidim_short) : t("decidim.secure_elections.elections.show.on_publication"),
                  end_date: election.end_at.present? ? l(election.end_at, format: :decidim_short) : t("decidim.secure_elections.elections.show.no_end_date")) %>
          <% end %>
        </span>
      <% end %>
    </div>

    <h1 class="h2 decorator"><%= translated_attribute(election.title) %></h1>

    <div class="editor-content">
      <%= decidim_sanitize_editor_admin(translated_attribute(election.description)) %>
    </div>
  </section>

  <%#
    The live stream, when the organiser attached one. It is rendered as a link
    rather than embedded: the URL is admin-authored and can point anywhere, and
    an iframe would hand that third party a frame on the election page.
  %>
  <% if election.stream_uri.present? %>
    <section class="layout-main__section">
      <h2 class="h4 decorator"><%= t("decidim.secure_elections.elections.show.stream_title") %></h2>
      <p>
        <%= link_to election.stream_uri, election.stream_uri,
                    class: "text-secondary underline",
                    target: "_blank",
                    rel: "noopener noreferrer" %>
      </p>
    </section>
  <% end %>

  <section class="layout-main__section">
    <h2 class="h4 decorator"><%= t("decidim.secure_elections.elections.show.questions_title") %></h2>
    <%= render partial: "questions" %>
  </section>

  <% if election.on_chain? %>
    <section class="layout-main__section">
      <%= cell("decidim/secure_elections/election_results", election,
               questions:,
               status_url: status_election_path(election, format: :json)) %>
    </section>
  <% end %>
<% end %>
