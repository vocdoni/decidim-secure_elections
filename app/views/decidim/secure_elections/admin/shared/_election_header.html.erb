<div class="item_show__header border-none">
  <h1 class="item_show__header-title">
    <%= local_assigns.fetch(:title, present(election).title(html_escape: true)) %>
    <%= secure_elections_election_status_label(election) %>
    <% unless election.published? %>
      <span class="label basic"><%= t("decidim.secure_elections.admin.elections.not_on_public_site") %></span>
    <% end %>
  </h1>

  <div class="flex items-center gap-2">
    <% if election.published? %>
      <%# The button an admin reaches for after publishing: it opens the
          participant-facing page in a new tab, so they can see the election
          exactly as a voter would without navigating away from the admin. %>
      <%= link_to resource_locator(election).path,
                  class: "button button__sm button__secondary flex flex-row items-center gap-2",
                  target: :blank,
                  data: { "external-link": false } do %>
        <%= icon "eye-line", class: "inline-block" %>
        <span class="whitespace-nowrap"><%= t("decidim.secure_elections.admin.elections.view") %></span>
      <% end %>
    <% end %>
  </div>
</div>

<% if (reason = vocdoni_locked_reason(election)) %>
  <%= cell "decidim/announcement", reason, callout_class: "warning" %>
<% end %>

<% if election.last_error_message.present? %>
  <%= cell "decidim/announcement",
           { title: t("decidim.secure_elections.admin.errors.last_job_failure"), body: election.last_error_message },
           callout_class: "alert" %>
<% end %>
