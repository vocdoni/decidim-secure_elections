<%#
  One question card in the ballot editor, matching upstream
  decidim-elections DOM conventions.

  The card-divider is the entire drag surface (html5sortable grabs the
  whole header). Collapse/Remove are in the header so they are always
  visible even when the card body is collapsed.

  Locals:
    form_name  — the outer form's object_name ("election")
    index      — Integer position in the list, or "questionnaire-question-id"
                 in the <script> blueprint that createEditableForm() clones
    question   — QuestionForm instance
    election   — the Election record (for context, not mutated here)
%>
<%
  parent_name = "#{form_name}[questions][#{index}]"
  card_id     = question.id.presence || index.to_s
%>
<%= fields_for parent_name, question do |q| %>
  <div class="card questionnaire-question" id="accordion-<%= card_id %>-field">
    <div class="form__wrapper" data-controller="accordion">
      <div class="card-divider">
        <h2 class="card-title flex items-center">
          <span>
            <%= icon "draggable", class: "dragger hover:cursor-grab" %>
            <%# createEditableForm() sets up a LiveTextUpdateComponent per
                question card, keyed on `.question-title-statement`. The
                component's `_run()` reads `.length` off the text, so an
                undefined `data-placeholder` crashes the whole editor setup
                and every downstream handler (add/remove response option,
                add question) with it. Ship the class + placeholder even
                though our field is `[title]` rather than upstream's
                `[body]` — the input selector never matches so no live sync
                happens here, but the crash is what actually mattered. %>
            <span class="question-title-statement"
                  data-locale="en"
                  data-max-length="50"
                  data-omission="…"
                  data-placeholder="<%= t("decidim.secure_elections.admin.questions.question.title_placeholder", default: "New question") %>"></span>
          </span>
          <span class="ml-auto flex flex-row-reverse items-center gap-2">
            <button type="button"
                    class="question--collapse"
                    data-controls="panel-<%= card_id %>-question-card">
              <span class="icon-collapse"><%= icon "arrow-up-s-line" %></span>
              <span class="icon-expand"><%= icon "arrow-down-s-line" %></span>
            </button>
            <button type="button"
                    class="button button__xs button__transparent-secondary small alert remove-question button--title">
              <%= icon "delete-bin-line" %>
              <span class="hidden md:block">
                <%= t("decidim.secure_elections.admin.questions.question.remove") %>
              </span>
            </button>
          </span>
        </h2>
      </div>

      <div id="panel-<%= card_id %>-question-card" class="mt-4 card-section collapsible">
        <%= q.translated :text_field, :title,
                         label: t("decidim.secure_elections.admin.questions.question.statement_label") %>
        <%= q.translated :editor, :description,
                         label: t("decidim.secure_elections.admin.questions.question.description_label") %>
        <%= q.select :question_type,
                     options_for_select(secure_elections_question_type_options, q.object.question_type),
                     label: t("decidim.secure_elections.admin.questions.question.question_type_label") %>

        <%# These two hidden fields are submitted with every save.
            `id` lets the command match the form row to its DB record.
            `deleted` is set to "true" by DynamicFieldsComponent when the admin
            clicks Remove; the command destroys rows absent from the kept set. %>
        <%= q.hidden_field :id if question.persisted? %>
        <%= q.hidden_field :deleted, value: false %>

        <%# Response-option list for this question. The Add button and the
            blueprint template live at the outer form level (see
            _form.html.erb) — createEditableForm() finds the shared
            `.decidim-response-option-template` and inserts a clone into
            the `.questionnaire-question-response-options-list` scoped to
            this card. Nesting the template <script> inside this card,
            which itself lives inside the question-template <script>,
            terminates the outer script early and detaches this list. %>
        <div class="questionnaire-question-response-options">
          <div class="questionnaire-question-response-options-list">
            <% question.answers.each_with_index do |answer, answer_index| %>
              <%= render partial: "decidim/secure_elections/admin/questions/response_option",
                         locals: { parent_name:, answer:, index: answer_index, question_index: index } %>
            <% end %>
          </div>

          <button type="button"
                  class="button button__sm button__transparent-secondary add-response-option">
            <%= t("decidim.secure_elections.admin.questions.question.add_response_option") %>
          </button>
        </div>

        <%# max_choices only matters for multichoice; the JS hides this field
            for singlechoice questions and, when it is visible, keeps its
            options in sync with the number of response options. Upstream keys
            on the `.questionnaire-question-max-choices` wrapper class to find
            the select from the outer editor. The range starts at 2 (the
            minimum) up to the current number of options. %>
        <div class="questionnaire-question-max-choices row column">
          <%= q.select :max_choices,
                       options_for_select(
                         [[t("decidim.secure_elections.admin.questions.question.max_choices_any"), ""]].concat(
                           (2..([2, question.number_of_options].max)).map { |n| [n.to_s, n] }
                         ),
                         question.max_choices
                       ),
                       { label: t("decidim.secure_elections.admin.questions.question.max_choices_label"),
                         include_blank: false } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
