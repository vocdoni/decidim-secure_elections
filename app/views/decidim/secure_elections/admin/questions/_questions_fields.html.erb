<%#
  Step 2: the ballot.

  Questions *and* their options are on this one page: adding a question or an
  option happens in the browser, and the whole ballot is submitted at once. Everything here is progressive enhancement over
  a form that already works without JavaScript.

  Locals: `form` (the Decidim form builder), `election`.
%>
<%
  disabled = !form.object.editable?
  form_name = form.object_name
  questions = form.object.questions
%>

<% append_javascript_pack_tag "decidim_secure_elections_admin" %>

<div id="js-vocdoni-election-editor"
     class="vocdoni-editor form__wrapper"
     data-vocdoni-editor
     data-next-question-index="<%= questions.size %>"
     data-autosave-url="<%= election.editable? ? autosave_election_questions_path(election) : "" %>"
     data-autosave-interval="30000"
     data-unsaved-warning="<%= t("decidim.secure_elections.admin.elections.editor.unsaved_warning") %>"
     <%#
       Numbering that has to be rebuilt in the browser after every add, remove
       or reorder. `__N__` and `__T__` are substituted client-side, which keeps
       the strings translatable instead of being assembled from fragments.
     %>
     data-question-number-template="<%= t("decidim.secure_elections.admin.elections.editor.question_number", number: "__N__", total: "__T__") %>"
     data-question-legend-template="<%= t("decidim.secure_elections.admin.elections.editor.question_legend", number: "__N__") %>"
     data-option-placeholder-template="<%= t("decidim.secure_elections.admin.elections.editor.option_placeholder", number: "__N__") %>"
     <%#
       The accessible names of the reordering controls. They name the question
       or the option they act on, so they move with it: `__N__` is the position
       of the thing itself and `__Q__` the question it belongs to.
     %>
     data-move-question-up-template="<%= t("decidim.secure_elections.admin.elections.editor.move_question_up", number: "__N__") %>"
     data-move-question-down-template="<%= t("decidim.secure_elections.admin.elections.editor.move_question_down", number: "__N__") %>"
     data-remove-question-template="<%= t("decidim.secure_elections.admin.elections.editor.remove_question", number: "__N__") %>"
     data-move-option-up-template="<%= t("decidim.secure_elections.admin.elections.editor.move_option_up", number: "__N__", question: "__Q__") %>"
     data-move-option-down-template="<%= t("decidim.secure_elections.admin.elections.editor.move_option_down", number: "__N__", question: "__Q__") %>"
     data-remove-option-template="<%= t("decidim.secure_elections.admin.elections.editor.remove_option", number: "__N__", question: "__Q__") %>"
     data-announce-question-added="<%= t("decidim.secure_elections.admin.elections.editor.announce.question_added") %>"
     data-announce-question-removed="<%= t("decidim.secure_elections.admin.elections.editor.announce.question_removed") %>"
     data-announce-option-added="<%= t("decidim.secure_elections.admin.elections.editor.announce.option_added") %>"
     data-announce-option-removed="<%= t("decidim.secure_elections.admin.elections.editor.announce.option_removed") %>"
     data-announce-moved="<%= t("decidim.secure_elections.admin.elections.editor.announce.moved") %>"
     data-announce-saving="<%= t("decidim.secure_elections.admin.elections.editor.announce.saving") %>"
     data-announce-saved="<%= t("decidim.secure_elections.admin.elections.editor.announce.saved") %>"
     data-announce-save-failed="<%= t("decidim.secure_elections.admin.elections.editor.announce.save_failed") %>">

  <%#
    One live region for the whole step. Adding, removing and reordering happen
    without a page load, so they have to be announced; the autosave state is
    reported here too rather than as a silent visual cue.
  %>
  <p class="text-sm text-gray-2 mt-2 mb-0"
     id="js-vocdoni-editor-status"
     data-vocdoni-status
     role="status"
     aria-live="polite"></p>

  <%#
    Question type and result visibility both apply to the whole ballot, so they
    share one card and one heading, and they are rendered identically: visible
    label, help text, select.

    Never with an `sr-only` label. `Decidim::FormBuilder` nests the control
    *inside* its `<label>` (`custom_label` yields the field into the label
    body), so clipping the label to 1px clips the select with it — which is how
    the question type ended up invisible, unfocusable, and multiple-choice
    elections unreachable from the UI.
  %>
  <section class="card" aria-labelledby="js-vocdoni-ballot-settings-title">
    <div class="card-divider">
      <h2 class="card-title" id="js-vocdoni-ballot-settings-title">
        <%= t("decidim.secure_elections.admin.elections.editor.ballot_settings_title") %>
      </h2>
    </div>

    <div class="card-section">
      <%#
        Selected by data attribute rather than by id: Decidim derives the
        label's `for` from the generated id, so overriding the id would
        quietly detach the label from the field.
      %>
      <%= form.select :question_type,
                      options_for_select(secure_elections_question_type_options, form.object.question_type),
                      { label: t("decidim.secure_elections.admin.elections.editor.question_type_label"),
                        help_text: t("decidim.secure_elections.admin.elections.editor.question_type_help") },
                      data: { "vocdoni-question-type": true },
                      disabled: disabled %>
    </div>

    <%#
      Result visibility is a property of the ballot — it is the per-question
      `secret_until_the_end` column — so it belongs next to the questions
      rather than in a schedule step.
    %>
    <div class="card-section border-t border-gray-3">
      <%= form.select :result_visibility,
                      options_for_select(vocdoni_result_visibility_options, form.object.result_visibility),
                      { label: t("decidim.secure_elections.admin.elections.editor.result_visibility_label"),
                        help_text: t("decidim.secure_elections.admin.elections.editor.result_visibility_help") },
                      disabled: disabled %>
    </div>
  </section>

  <%# "An election needs a question" belongs above the questions, where the
      first thing to do is. The first card's title input is flagged as well
      (`ElectionQuestionsForm#at_least_one_question`), so an empty page answers
      an empty submit with something to read *and* something to look at.

      Read through `#ballot_error` rather than `error_for(:questions)`: the
      latter also carries the `:invalid` the form object adds whenever any
      nested question fails, which would top the page with "is invalid" every
      time a single option was missing further down. %>
  <% if form.object.ballot_error.present? %>
    <small class="form-error is-visible block mt-4" role="alert"><%= form.object.ballot_error %></small>
  <% end %>

  <ul class="list-none m-0 mt-4" data-vocdoni-questions>
    <% questions.each_with_index do |question, index| %>
      <%= render partial: "decidim/secure_elections/admin/elections/question_fields",
                 locals: {
                   form_name:,
                   index:,
                   number: index + 1,
                   total: questions.size,
                   question:,
                   multichoice: form.object.multichoice?,
                   disabled:
                 } %>
    <% end %>
  </ul>

  <% unless disabled %>
    <button type="button"
            class="button button__sm button__transparent-secondary w-full justify-center border border-gray-3"
            data-vocdoni-add-question>
      <%= icon "add-line" %>
      <span><%= t("decidim.secure_elections.admin.elections.editor.add_question") %></span>
    </button>
  <% end %>

  <%= render partial: "decidim/secure_elections/admin/elections/field_templates",
             locals: { form_name:, multichoice: form.object.multichoice? } unless disabled %>
</div>
