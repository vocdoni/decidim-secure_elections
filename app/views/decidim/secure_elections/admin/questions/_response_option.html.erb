<%#
  One response option card within a question, matching upstream
  decidim-elections DOM conventions.

  Response options are not drag-reorderable (upstream does not support
  it and neither does vd — the choice value is positional and fixed at
  publish time).

  Locals:
    parent_name    — the question's field name prefix
    answer         — AnswerForm instance
    index          — Integer position, or "DECIDIM_RECORD_ID" in templates
    question_index — parent question's index (or "DECIDIM_RECORD_ID")
%>
<%= fields_for "#{parent_name}[answers][#{index}]", answer do |o| %>
  <div class="card questionnaire-question-response-option mx-4 my-8">
    <div class="card-divider">
      <h2 class="card-title mb-2">
        <span><%= t("decidim.secure_elections.admin.questions.response_option.title") %></span>
        <%# Right-aligned action strip, mirroring the question card header
            layout. createEditableForm() toggles the remove button's
            visibility (see `hideOnMinItemsOrLessSelector`) — no inline
            style needed. %>
        <span class="ml-auto flex flex-row-reverse items-center gap-2">
          <button type="button"
                  class="button button__xs button__transparent-secondary small alert remove-response-option button--title">
            <%= icon "delete-bin-line" %>
            <span class="hidden md:block">
              <%= t("decidim.secure_elections.admin.questions.response_option.remove") %>
            </span>
          </button>
        </span>
      </h2>
    </div>
    <div class="card-section">
      <div class="row column">
        <%= o.translated :text_field, :body,
                         label: t("decidim.secure_elections.admin.questions.response_option.statement_label") %>
      </div>
    </div>
    <%= o.hidden_field :id if answer.persisted? %>
    <%= o.hidden_field :deleted, value: false %>
  </div>
<% end %>
