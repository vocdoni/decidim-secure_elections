<%#
  Questions tab: outer container for the ballot editor.

  DOM contract mirrors decidim-elections upstream, verified against
  try.decidim.org. Both the question-card blueprint and the shared
  response-option blueprint are top-level SIBLINGS inside
  `.questionnaire-questions.form__wrapper`, never nested. A
  `<script type="text/template">` inside another `<script>` is not a
  script inside a script — the browser terminates the outer script at
  the FIRST `</script>` it sees, so the rest of the outer blueprint
  (the response-options list and its Add button) escapes into real DOM
  and lands next to the question card instead of inside it.

  Placeholders match the upstream DynamicFieldsComponent (`createEditableForm`
  in `decidim_forms_admin`): `questionnaire-question-id` for the parent
  question, `questionnaire-question-response-option-id` for a new option.
  The class hooks (`decidim-question-template`, `decidim-response-option-template`)
  are what `createEditableForm` looks up to find the blueprints; the ids
  are for `data-controls` back-references only.

  Locals: form (the Decidim form builder), election.
%>
<%
  form_name = form.object_name
  questions = form.object.questions
  blank_q   = Decidim::SecureElections::Admin::QuestionForm.blank_question
%>

<div class="questionnaire-questions form__wrapper">
  <div class="row column text-right my-4">
    <button type="button" class="button button__sm button__text-secondary collapse-all">
      <%= t("decidim.secure_elections.admin.questions.form.collapse_all") %>
    </button>
    <span aria-hidden="true"> | </span>
    <button type="button" class="button button__sm button__text-secondary expand-all">
      <%= t("decidim.secure_elections.admin.questions.form.expand_all") %>
    </button>
  </div>

  <%# Question card blueprint. Cloned when the admin clicks "Add question";
      `questionnaire-question-id` is the placeholder createEditableForm
      swaps for a fresh id on each clone. %>
  <script type="text/template" id="question-template" class="decidim-question-template decidim-template">
    <%= render partial: "decidim/secure_elections/admin/questions/question",
               locals: { form_name:, index: "questionnaire-question-id", question: blank_q, election: } %>
  </script>

  <%# Shared response-option blueprint. One instance is enough for every
      question card — createEditableForm finds it by the
      `.decidim-response-option-template` class and, at clone time,
      substitutes the enclosing question id for `questionnaire-question-id`
      and a fresh option id for `questionnaire-question-response-option-id`.
      The `-dummy` suffix on the id is upstream's convention for
      "single shared instance, id irrelevant". %>
  <script type="text/template" id="response-option-template-dummy" class="decidim-response-option-template decidim-template">
    <%= render partial: "decidim/secure_elections/admin/questions/response_option",
               locals: {
                 parent_name: "#{form_name}[questions][questionnaire-question-id]",
                 answer: Decidim::SecureElections::Admin::AnswerForm.new,
                 index: "questionnaire-question-response-option-id",
                 question_index: "questionnaire-question-id"
               } %>
  </script>

  <div class="questionnaire-questions-list flex flex-col py-6 gap-6 last:pb-0"
       id="questionnaire-questions-list"
       data-draggable-table
       data-draggable-handle=".card-divider">
    <% questions.each_with_index do |question, index| %>
      <%= render partial: "decidim/secure_elections/admin/questions/question",
                 locals: { form_name:, index:, question:, election: } %>
    <% end %>
  </div>
</div>
