<%#
  Census tab — voter-authentication configuration only. Roster management
  (People card + Add-people section + Clear census) moved to
  `election_census_members_path` so this tab does one thing: match upstream
  decidim-elections' Census tab, which is "pick your census type and configure
  it". A "Manage people (N)" link at the bottom jumps to the members page.

  The manifest selector (`#census-manifest-selector`) switches between
  per-manifest form partials via Turbo; today only "internal_users" is
  registered so the select has one option. Future manifests (token_csv,
  dataset_csv, …) plug in by adding a manifest key and a corresponding
  partial under `admin/censuses/`.

  The authentication-configuration form (`#census-election-form`) is
  submitted by the sticky "Save and continue" button via the HTML `form`
  attribute, so the button can live outside the `<form>` element.
%>
<% add_decidim_page_title(t(".page_title")) %>

<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "nav", locals: { election: } %>

<div class="form-defaults my-8 flex justify-end">
  <%= select_tag "census_manifest",
                 options_for_select(@census_manifests.map { |m| [t(".manifests.#{m}"), m] }, @form.manifest),
                 id: "census-manifest-selector" %>
</div>

<% if election.census_complete? %>
  <%= cell "decidim/announcement", t(".census_ready"), callout_class: "success" %>
<% end %>

<div class="card-section census-form form-defaults 2xl:mr-80">
  <%= decidim_form_for(@form, url: election_census_path(election), method: :patch,
                       html: { id: "census-election-form", class: "form edit_census" }) do |f| %>
    <%= render partial: "decidim/secure_elections/admin/censuses/internal_users_form",
               locals: { form: f, election: } %>
  <% end %>
</div>

<%# Anything the upstream group validation complained about, named. %>
<% if reported_missing_members.any? %>
  <div class="mt-4">
    <%= cell "decidim/announcement",
             { title: t(".reported_missing_title", count: reported_missing_members.size),
               body: t(".reported_missing_body", names: reported_missing_members.map(&:display_name).to_sentence) },
             callout_class: "alert" %>
  </div>
<% end %>

<%# A single link out to the roster manager. The count is inline so the admin
    knows at a glance how many people are already on the census without having
    to click through. %>
<% if allowed_to?(:update, :census, election:) %>
  <div class="mt-6">
    <%#
      The dirty-form guard on this link (see `setupDirtyGuard` in census.js)
      catches the case an admin ticks a credential, then jumps here to fill
      the roster, and loses the tick. The message travels on the link so
      translation stays in the ERB.
    %>
    <%= link_to election_census_members_path(election),
                class: "flex items-center gap-2 text-secondary",
                data: { "confirm-if-dirty": t(".manage_people_confirm_if_dirty") } do %>
      <%= icon "group-2-line", class: "!w-4 !h-4", aria_hidden: true %>
      <span><%= t(".manage_people", count: census_members.size) %></span>
      <%= icon "arrow-right-line", class: "!w-4 !h-4", aria_hidden: true %>
    <% end %>
  </div>
<% end %>

<div class="item__edit-sticky">
  <div class="item__edit-sticky-container">
    <%= button_tag t(".save_and_continue"),
                   form: "census-election-form",
                   class: "button button__sm button__secondary" %>
  </div>
</div>
