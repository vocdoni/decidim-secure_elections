<%#
  Census tab — upstream layout: manifest selector at top, inline auth-config
  form, 5-row preview, sticky Save on the right.

  The manifest selector (`#census-manifest-selector`) switches between
  per-manifest form partials via Turbo; today only "internal_users" is
  registered so the select has one option.  Future manifests (token_csv,
  dataset_csv, …) plug in by adding a manifest key and a corresponding
  partial under `admin/censuses/`.

  The authentication-configuration form (`#census-election-form`) is
  submitted by the sticky Save button via the HTML `form` attribute, so
  the button can live outside the `<form>` element.

  The members-management section (people count, edit-table link, CSV
  import, verification import) lives below the form and is unchanged from
  vd's original census screen — it is not part of any manifest form
  because those actions POST to their own endpoints.
%>
<% add_decidim_page_title(t(".page_title")) %>

<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "nav", locals: { election: } %>

<div class="form-defaults my-8 flex justify-end">
  <%= select_tag "census_manifest",
                 options_for_select(@census_manifests.map { |m| [t(".manifests.#{m}"), m] }, @form.manifest),
                 id: "census-manifest-selector" %>
</div>

<% if election.census_complete? %>
  <%= cell "decidim/announcement", t(".census_ready"), callout_class: "success" %>
<% end %>

<div class="card-section census-form form-defaults 2xl:mr-80">
  <%= decidim_form_for(@form, url: election_census_path(election), method: :patch,
                       html: { id: "census-election-form", class: "form edit_census" }) do |f| %>
    <%= render partial: "decidim/secure_elections/admin/censuses/internal_users_form",
               locals: { form: f, election: } %>
  <% end %>

  <%= render partial: "decidim/secure_elections/admin/census/preview", locals: { election: } if preview_users(election).present? %>
</div>

<%# Anything the upstream group validation complained about, named. %>
<% if reported_missing_members.any? %>
  <div class="mt-4">
    <%= cell "decidim/announcement",
             { title: t(".reported_missing_title", count: reported_missing_members.size),
               body: t(".reported_missing_body", names: reported_missing_members.map(&:display_name).to_sentence) },
             callout_class: "alert" %>
  </div>
<% end %>

<div class="card mt-4">
  <div class="card-divider">
    <h2 class="card-title justify-between">
      <span class="text-black font-bold">
        <%= t(".people_title") %>
        <span class="label basic"><%= t(".people_count", count: census_members.size) %></span>
      </span>

      <% if allowed_to?(:update, :census, election:) %>
        <%= link_to election_census_members_path(election), class: "flex items-end justify-between gap-x-3 text-sm" do %>
          <%= icon "pencil-line", class: "!w-4 !h-4" %>
          <%= t(".edit_people") %>
        <% end %>
      <% end %>
    </h2>
  </div>

  <div class="card-section">
    <% if census_members.none? %>
      <p class="text-gray-2"><%= t(".people_empty") %></p>
    <% else %>
      <% if incomplete_members.any? %>
        <%= cell "decidim/announcement",
                 { title: t(".incomplete_title", count: incomplete_members.size),
                   body: t(".incomplete_body",
                           details: election.census_members_missing_by_field
                                            .map { |field, count| t(".missing_field", count:, field: Decidim::SecureElections::CensusMember.field_label(field)) }
                                            .to_sentence) },
                 callout_class: "alert" %>
      <% end %>
    <% end %>
  </div>

  <% if allowed_to?(:update, :census, election:) && census_members.any? %>
    <div class="card-section border-t">
      <%= link_to t(".clear"),
                  election_census_clear_path(election),
                  method: :delete,
                  class: "button button__xs button__transparent-secondary",
                  data: { confirm: t(".clear_confirm", count: census_members.size) } %>
    </div>
  <% end %>
</div>

<% if allowed_to?(:update, :census, election:) %>
  <div class="card mt-4">
    <div class="card-divider">
      <h2 class="card-title">
        <span class="text-black font-bold"><%= t(".add_people_title") %></span>
      </h2>
    </div>

    <div class="card-section">
      <p class="text-sm text-gray-2 mb-4"><%= t(".add_people_help") %></p>

      <%= render partial: "import", locals: { election:, form: import_form } %>
      <%= render partial: "verifications", locals: { election:, form: verifications_form, handlers: available_handlers } %>
    </div>
  </div>
<% end %>

<div class="item__edit-sticky">
  <div class="item__edit-sticky-container">
    <%= button_tag t(".save"),
                   form: "census-election-form",
                   class: "button button__sm button__secondary#{" hide" unless election.census_configured?}" %>
  </div>
</div>
