<%#
  Step 4 of 5: when voting happens.

  Two decisions. Either the election opens the moment it reaches the blockchain
  — stored as no start time at all, never as "now" — or at a moment the admin
  picks. The end is always required: upstream refuses a process without one, and
  an election that never closes can never be tallied.

  The start field is revealed by the editor pack when "start immediately" is
  off. Without JavaScript it simply stays visible and the form object drops the
  value, so the page still submits correctly.
%>
<% add_decidim_page_title(t(".title")) %>

<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "decidim/secure_elections/admin/shared/nav", locals: { election: } %>

<% append_javascript_pack_tag "decidim_secure_elections_admin" %>

<% disabled = !election.editable? %>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= decidim_form_for(@form,
                         url: election_calendar_path(election),
                         method: :patch,
                         html: { id: "edit-election-calendar-form", class: "form-defaults form edit_election_calendar" }) do |f| %>
      <div class="vocdoni-editor form__wrapper" data-vocdoni-editor>
        <div class="card">
          <div class="card-divider">
            <h2 class="card-title"><%= t(".card_title") %></h2>
          </div>

          <div class="card-section">
            <fieldset>
              <legend class="sr-only"><%= t(".card_title") %></legend>

              <p class="help-text">
                <%= t("decidim.secure_elections.admin.elections.editor.timezone_notice",
                      timezone: "#{current_organization.time_zone} (#{l(Time.current.in_time_zone(current_organization.time_zone), format: :long)})") %>
              </p>

              <%#
                Selected by data attribute rather than by id: Decidim derives
                the label's `for` from the generated id, so overriding the id
                would quietly detach the label from the checkbox.
              %>
              <%= f.check_box :start_immediately,
                              label: t("decidim.secure_elections.admin.elections.editor.start_immediately"),
                              data: { "vocdoni-start-immediately": true },
                              disabled: disabled,
                              help_text: t("decidim.secure_elections.admin.elections.editor.start_immediately_help") %>

              <div data-vocdoni-start-time <%= "hidden" if @form.start_immediately? %>>
                <%= f.datetime_field :start_time,
                                     label: t("decidim.secure_elections.models.election.fields.start_time"),
                                     disabled: disabled %>
              </div>

              <%= f.datetime_field :end_time,
                                   label: t("decidim.secure_elections.admin.elections.editor.end_datetime"),
                                   help_text: t("decidim.secure_elections.admin.elections.editor.end_datetime_help"),
                                   disabled: disabled %>
            </fieldset>
          </div>
        </div>
      </div>

      <%= render partial: "decidim/secure_elections/admin/shared/step_footer",
                 locals: { election:, step: :calendar, form: f } %>
    <% end %>
  </div>
</div>
