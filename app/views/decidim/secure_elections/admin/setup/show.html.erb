<%#
  The point of no return.

  Everything on this page exists to make one thing unmissable: pressing the
  button writes the election to a public blockchain, and nothing after that can
  be edited, deleted or taken back.

  Hence the checklist and the explicit acknowledgement: the two things standing
  between an administrator and an irreversible write.
%>
<% add_decidim_page_title(t(".title")) %>

<%
  # One row per wizard step, each linking back to the step that owns it.
  checks = [
    [:details, election.details_complete?, secure_elections_step_path(election, :details)],
    [:questions, election.questions_complete?, secure_elections_step_path(election, :questions)],
    [:census, election.census_complete?, secure_elections_step_path(election, :census)],
    [:calendar, election.calendar_complete?, secure_elections_step_path(election, :calendar)],
    [:configuration, module_configured?, nil]
  ]
  ready = checks.all? { |(_key, ok, _path)| ok } && election.editable?
  publishing = election.publishing?
%>

<%= render partial: "decidim/secure_elections/admin/shared/configuration_warning" %>
<%= render partial: "decidim/secure_elections/admin/shared/election_header", locals: { election: } %>
<%= render partial: "decidim/secure_elections/admin/shared/nav", locals: { election:, current: :publish } %>

<%= cell "decidim/announcement",
         { title: t(".irreversible_title"), body: t(".irreversible_body") },
         callout_class: "alert" %>

<div class="card">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".checklist_title") %></h2>
  </div>

  <div class="card-section">
    <ul class="list-none">
      <% checks.each do |(key, ok, path)| %>
        <%# Whether a check has passed is the only thing on this list worth
            reading, and it was carried by the icon alone: `icon` sets
            `aria-hidden="true"` and keeps it even when given an `aria_label`,
            so all five rows reached the accessibility tree identical. The
            verdict is text now, and the icon is decorative for real. %>
        <li class="flex items-center gap-2 mb-2">
          <% if ok %>
            <%= icon "check-line", class: "fill-success", aria_hidden: true %>
            <span class="sr-only"><%= t(".check_ok") %>:</span>
          <% else %>
            <%= icon "error-warning-line", class: "fill-alert", aria_hidden: true %>
            <span class="sr-only"><%= t(".check_missing") %>:</span>
          <% end %>
          <span><%= t(key, scope: "decidim.secure_elections.admin.setup.checks") %></span>
          <% if !ok && path %>
            <%= link_to t(".fix_it"), path, class: "text-secondary text-sm underline" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="card mt-4">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".summary_title") %></h2>
  </div>

  <div class="card-section">
    <dl>
      <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.title") %></dt>
      <dd class="mb-4"><%= present(election).title(html_escape: true) %></dd>

      <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.start_time") %></dt>
      <dd class="mb-4"><%= vocdoni_start_time_text(election) %></dd>

      <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.end_time") %></dt>
      <dd class="mb-4"><%= l(election.end_time, format: :decidim_short) if election.end_time %></dd>

      <dt class="h6"><%= t("decidim.secure_elections.admin.elections.editor.census_title") %></dt>
      <dd class="mb-4">
        <% if election.census_configured? %>
          <%= election.auth_fields.map { |field| t(field, scope: "decidim.secure_elections.auth_fields", default: field) }.to_sentence %>
          <% if election.auth_only? %>
            <span class="label secondary"><%= t("decidim.secure_elections.admin.census.auth_only") %></span>
          <% end %>
        <% else %>
          <span class="label alert"><%= t("decidim.secure_elections.admin.census.not_configured") %></span>
        <% end %>
      </dd>

      <dt class="h6"><%= t("decidim.secure_elections.models.election.fields.questions") %></dt>
      <dd>
        <ol class="list-decimal ml-4">
          <% election.questions.each do |question| %>
            <li>
              <%= present(question).title(html_escape: true) %>
              <span class="text-gray-2 text-sm">
                (<%= t(question.question_type, scope: "decidim.secure_elections.question_types") %>,
                <%= t("decidim.secure_elections.admin.elections.options_count", count: question.answers_count) %>)
              </span>
            </li>
          <% end %>
        </ol>
      </dd>
    </dl>
  </div>
</div>

<div class="card mt-4">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".confirm_title") %></h2>
  </div>

  <div class="card-section">
    <% if publishing %>
      <%= cell "decidim/announcement", t(".in_progress"), callout_class: "warning" %>
    <% end %>

    <%#
      The acknowledgement is enforced by `SetupForm` — that check is the lock
      and it stays. The pack adds a second one, disabling the button until the
      acknowledgement is ticked, so that the button for an unrecoverable action
      is never simply sitting there waiting to be pressed. Without the pack the
      button is enabled and the server refuses.
    %>
    <div id="js-vocdoni-setup">
      <%= decidim_form_for(@form, url: election_setup_path(election), method: :post, html: { id: "setup-form", class: "form-defaults form" }) do |f| %>
        <div class="row column">
          <%= f.check_box :confirm_irreversible,
                          label: t(".confirm_irreversible_label"),
                          disabled: !ready || publishing,
                          data: { "vocdoni-confirm-irreversible": true } %>
        </div>

        <div class="row column mt-4">
          <% if ready && !publishing %>
            <%= f.submit t(".publish_button"),
                         class: "button button__sm alert",
                         data: { "vocdoni-publish": true } %>
            <p class="text-sm text-gray-2 mt-2" data-vocdoni-publish-hint hidden>
              <%= t(".publish_needs_confirmation") %>
            </p>
          <% else %>
            <button type="submit" class="button button__sm alert" disabled aria-disabled="true">
              <%= t(".publish_button") %>
            </button>
            <p class="text-sm text-gray-2 mt-2">
              <%= publishing ? t(".in_progress") : t(".publish_disabled") %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render partial: "decidim/secure_elections/admin/shared/public_link", locals: { election: } %>
