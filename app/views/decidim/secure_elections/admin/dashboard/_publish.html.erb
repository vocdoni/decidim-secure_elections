<%#
  The publish action, rendered as the last card in the body of the
  pre-publish Dashboard: confirm_irreversible checkbox + "Publish on
  the blockchain" submit button.

  This used to live inside `.item__edit-sticky` in the sidebar column
  of the Dashboard, but the sticky container carries a dark background
  from Decidim's admin theme — the confirm-irreversible label ended up
  close-to-invisible against it, and the submit button lost its red
  colour when disabled. Putting it in a normal card in the body keeps
  the flow readable and lines up with the surrounding cards' styling
  and padding conventions.

  Locals: `election`, `form` (a SetupForm instance)
%>
<%
  checks_pass = election.details_complete? &&
                election.questions_complete? &&
                election.census_complete? &&
                election.calendar_complete?
  ready      = checks_pass && election.editable?
  publishing = election.publishing?
%>

<% if publishing %>
  <%= cell "decidim/announcement", t("decidim.secure_elections.admin.setup.show.in_progress"), callout_class: "warning" %>
<% end %>

<div id="js-vocdoni-setup" class="card mb-6">
  <div class="card-section">
    <div class="row column">
      <%= decidim_form_for(form,
                           url: publish_election_dashboard_path(election),
                           method: :post,
                           html: { id: "setup-form", class: "form-defaults form" }) do |f| %>
        <%= f.check_box :confirm_irreversible,
                        label: t("decidim.secure_elections.admin.setup.show.confirm_irreversible_label"),
                        disabled: !ready || publishing,
                        data: { "vocdoni-confirm-irreversible": true } %>

        <div class="mt-4">
          <% if ready && !publishing %>
            <%= f.submit t("decidim.secure_elections.admin.setup.show.publish_button"),
                         class: "button button__sm alert",
                         data: { "vocdoni-publish": true } %>
            <p class="text-sm text-gray-2 mt-2" data-vocdoni-publish-hint hidden>
              <%= t("decidim.secure_elections.admin.setup.show.publish_needs_confirmation") %>
            </p>
          <% else %>
            <button type="submit" class="button button__sm alert" disabled aria-disabled="true">
              <%= t("decidim.secure_elections.admin.setup.show.publish_button") %>
            </button>
            <p class="text-sm text-gray-2 mt-2">
              <%= publishing ? t("decidim.secure_elections.admin.setup.show.in_progress")
                            : t("decidim.secure_elections.admin.setup.show.publish_disabled") %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
