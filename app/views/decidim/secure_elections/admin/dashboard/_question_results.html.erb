<%# All figures come from `results_cache`; nothing here reaches the API. The
    `data-` hooks are what lets the pack swap the numbers in place after a
    refresh instead of asking the admin to reload. %>
<div class="card mb-4" id="vocdoni-question-<%= question.id %>" data-monitor-question="<%= question.id %>">
  <div class="card-divider">
    <h3 class="h6 flex items-center justify-between gap-2">
      <span>
        <%= present(question).title(html_escape: true) %>
        <small class="font-normal ml-2"><%= t(question.question_type, scope: "decidim.secure_elections.question_types") %></small>
      </span>
      <%= vocdoni_question_status_label(question) %>
    </h3>
  </div>

  <div class="card-section">
    <table class="table-list">
      <caption class="sr-only">
        <%= t("decidim.secure_elections.admin.monitor.results_caption", question: present(question).title) %>
      </caption>
      <thead>
        <tr>
          <th scope="col" class="w-1/2"><%= t("decidim.secure_elections.admin.monitor.answer") %></th>
          <th scope="col"><%= t("decidim.secure_elections.admin.monitor.votes") %></th>
          <th scope="col"><%= t("decidim.secure_elections.admin.monitor.percentage") %></th>
        </tr>
      </thead>
      <tbody>
        <% question.answers.each do |answer| %>
          <tr data-monitor-answer="<%= answer.id %>">
            <th scope="row" class="font-normal"><%= present(answer).title(html_escape: true) %></th>
            <td data-monitor-answer-votes><%= t("decidim.secure_elections.admin.monitor.votes_count", count: answer.votes_count) %></td>
            <td data-monitor-answer-percent><%= number_to_percentage(answer.votes_percent, precision: 1) %></td>
          </tr>
        <% end %>
        <tr>
          <th scope="row" class="border-none"><%= t("decidim.secure_elections.admin.monitor.total") %></th>
          <td class="border-none" data-monitor-question-votes><%= t("decidim.secure_elections.admin.monitor.votes_count", count: question.votes_count) %></td>
          <td class="border-none"></td>
        </tr>
      </tbody>
    </table>

    <% if question.vocdoni_upstream_id.present? %>
      <p class="text-sm text-gray-2 mt-2">
        <%= t("decidim.secure_elections.admin.monitor.upstream_id") %>
        <code class="break-all"><%= question.vocdoni_upstream_id %></code>
      </p>
    <% end %>
  </div>
</div>
