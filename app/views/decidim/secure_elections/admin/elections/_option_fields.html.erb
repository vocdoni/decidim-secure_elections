<%#
  One option of a question.

  `index` only keeps the parameter names apart; it is not the on-chain choice
  value. That value is derived from the option's position when the election is
  saved, so the ballot encoding stays contiguous and 0-based however the admin
  shuffles things around. When this partial is rendered into the `<template>`
  the editor clones from, `index` is the literal `__AIDX__`.

  The label is deliberately unnumbered: the options are a real list, so a screen
  reader already announces "item 3 of 5". Only the placeholder carries a number,
  and that is decorative — the editor renumbers it after every change.
%>
<% uid = "q#{question_index}-a#{index}" %>

<li class="vocdoni-option mb-2"
    data-vocdoni-option
    data-uid="<%= uid %>">
  <%= fields_for "#{parent_name}[answers][#{index}]", option do |o| %>
    <%= o.hidden_field :id, data: { "vocdoni-option-id-field": true } %>
    <%= o.hidden_field :uid, value: uid %>

    <%# Reorder and remove sit on their own row above the option so the input
        below fills the card the way the question title does. Named on the
        button, not on the icon: see `_question_fields`. An option number
        alone would repeat on every card, so the question is named too. %>
    <% unless disabled %>
      <div class="flex justify-end items-center gap-1">
        <button type="button"
                class="button button__xs button__transparent-secondary"
                aria-label="<%= t("decidim.secure_elections.admin.elections.editor.move_option_up", number: option_number, question: question_number) %>"
                data-vocdoni-move-option="up">
          <%= icon "arrow-up-line" %>
        </button>
        <button type="button"
                class="button button__xs button__transparent-secondary"
                aria-label="<%= t("decidim.secure_elections.admin.elections.editor.move_option_down", number: option_number, question: question_number) %>"
                data-vocdoni-move-option="down">
          <%= icon "arrow-down-line" %>
        </button>
        <button type="button"
                class="button button__xs button__transparent-secondary"
                aria-label="<%= t("decidim.secure_elections.admin.elections.editor.remove_option", number: option_number, question: question_number) %>"
                data-vocdoni-remove-option>
          <%= icon "close-line" %>
        </button>
      </div>
    <% end %>

    <div class="flex items-start gap-2">
      <%# Decorative preview of what the voter will see: a radio for a
          single-choice question, a box for a multiple-choice one. %>
      <span class="shrink-0 mt-3 w-4 h-4 border border-gray-3 <%= "rounded-full" unless multichoice %>"
            data-vocdoni-option-marker
            aria-hidden="true"></span>

      <div class="grow min-w-0">
        <%= secure_elections_language_selector_label("vocdoni-option-#{uid}-tabs",
                                            t("decidim.secure_elections.admin.elections.editor.option_placeholder", number: option_number)) %>
        <%= o.translated :text_field,
                         :title,
                         tabs_id: "vocdoni-option-#{uid}-tabs",
                         label: t("decidim.secure_elections.admin.elections.editor.option_label"),
                         label_options: { class: "sr-only" },
                         placeholder: t("decidim.secure_elections.admin.elections.editor.option_placeholder", number: option_number),
                         disabled: disabled %>
      </div>
    </div>
  <% end %>
</li>
