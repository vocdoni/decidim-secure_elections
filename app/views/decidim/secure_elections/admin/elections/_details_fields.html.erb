<%#
  Basic info card. Locals: `form`, `election` (nil on create).

  Title, an optional video and a description. Nothing more — an admin
  must be able to bring an election into existence before they have
  decided on the questions, the voters or the dates.
%>
<%
  disabled = !form.object.editable?
  election = local_assigns[:election]
%>

<%# The language switcher core renders next to a translatable field has no
    name of its own. See `ElectionsHelper#secure_elections_language_selector_label`;
    it goes first so it is read before the control it names. %>
<%= secure_elections_language_selector_label("vocdoni-election-title-tabs",
                                             t("decidim.secure_elections.admin.elections.editor.title_label")) %>
<%= form.translated :text_field,
                    :title,
                    tabs_id: "vocdoni-election-title-tabs",
                    label: t("decidim.secure_elections.admin.elections.editor.title_label"),
                    label_options: { class: "sr-only" },
                    placeholder: t("decidim.secure_elections.admin.elections.editor.title_placeholder"),
                    autofocus: true,
                    disabled: disabled %>

<%# Shown on the public election page; never sent to Vocdoni. %>
<details class="my-4" <%= "open" if form.object.stream_uri.present? %>>
  <summary class="text-sm text-gray-2 cursor-pointer">
    <%= t("decidim.secure_elections.admin.elections.editor.stream_summary") %>
  </summary>
  <div class="mt-2">
    <%= form.url_field :stream_uri,
                       label: t("decidim.secure_elections.admin.elections.editor.stream_label"),
                       placeholder: "https://www.youtube.com/watch?v=…",
                       help_text: t("decidim.secure_elections.admin.elections.editor.stream_help"),
                       disabled: disabled %>
  </div>
</details>

<%= secure_elections_language_selector_label("vocdoni-election-description-tabs",
                                             t("decidim.secure_elections.admin.elections.editor.description_label")) %>
<%= form.translated :editor,
                    :description,
                    tabs_id: "vocdoni-election-description-tabs",
                    label: t("decidim.secure_elections.admin.elections.editor.description_label"),
                    lines: 6,
                    disabled: disabled %>
