<div id="js-vocdoni-election-results"
     class="vocdoni-results"
     data-status-url="<%= status_url %>">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="h4 decorator"><%= t("decidim.elections.vocdoni.elections.results.title") %></h2>
    <p class="text-sm text-gray-2">
      <span data-election-votes-count><%= votes_count_text(election.votes_count) %></span>
      &middot;
      <%= final? ? t("decidim.elections.vocdoni.elections.results.final") : t("decidim.elections.vocdoni.elections.results.provisional") %>
    </p>
  </div>

  <%#
    When the figures above were last read from the voting network, in the same
    words the admin monitor uses. The page refreshes them by polling the local
    `status` endpoint, but it must never *claim* to be live: the claim has to be
    a fact the reader can check, and a timestamp that stops moving is a fact.
  %>
  <p class="text-sm text-gray-2" data-results-updated><%= last_updated_text %></p>

  <% questions.each do |question| %>
    <section class="vocdoni-results__question" data-results-question="<%= question.id %>">
      <h3 class="h5"><%= translated_attribute(question.body) %></h3>

      <% if secret?(question) %>
        <p class="text-gray-2">
          <%= icon "lock-line", role: "img", "aria-hidden": true, class: "inline fill-current" %>
          <%= t("decidim.elections.vocdoni.elections.results.secret_until_the_end") %>
        </p>
      <% else %>
        <ul class="list-none m-0 p-0 space-y-3">
          <% question.answers.each do |answer| %>
            <li class="vocdoni-results__answer" data-results-answer="<%= answer.id %>">
              <p class="font-semibold"><%= translated_attribute(answer.body) %></p>
              <div class="flex items-center justify-between gap-3">
                <div class="vocdoni-results__bar"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="<%= answer.votes_percent.round %>"
                     aria-label="<%= t("decidim.elections.vocdoni.elections.results.share_for", answer: translated_attribute(answer.body)) %>">
                  <span class="vocdoni-results__bar-fill" style="width: <%= answer.votes_percent.round(2) %>%" data-answer-bar></span>
                </div>
                <div class="vocdoni-results__figures">
                  <span data-answer-votes-percent><%= number_to_percentage(answer.votes_percent, precision: 1) %></span>
                  <span data-answer-votes-count><%= votes_count_text(answer.votes_count) %></span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>

        <p class="text-sm text-gray-2">
          <%= t("decidim.elections.vocdoni.elections.results.total") %>
          <span data-question-votes-count><%= votes_count_text(question.votes_count) %></span>
        </p>
      <% end %>
    </section>
  <% end %>
</div>
